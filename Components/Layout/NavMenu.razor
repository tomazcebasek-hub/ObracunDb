@using ObracunDb.Data.Entities
@using ObracunDb.Data.Menus
@using ObracunDb.Services
@inject NavigationManager NavigationManager
@inject AuthService AuthService
@inject MenuDovoljenjeService MenuDovoljenje
@implements IDisposable

<div>
    <DxMenu Orientation="@Orientation.Vertical" CssClass="menu">
        <Items>
            @foreach (var item in MenuDefinition.Vse)
            {
                if (!JeViden(item))
                {
                    continue;
                }

                if (item.ImaOtroke)
                {
                    <DxMenuItem Text="@item.Naziv" IconCssClass="@item.Ikona">
                        <Items>
                            @foreach (var child in item.Otroci)
                            {
                                if (!JeViden(child))
                                {
                                    continue;
                                }
                                <DxMenuItem NavigateUrl="@child.Url" Text="@child.Naziv" CssClass="@MenuItemCssClass(child.Url)" IconCssClass="@child.Ikona"></DxMenuItem>
                            }
                        </Items>
                    </DxMenuItem>
                }
                else
                {
                    <DxMenuItem NavigateUrl="@item.Url" Text="@item.Naziv" CssClass="@MenuItemCssClass(item.Url)" IconCssClass="@item.Ikona"></DxMenuItem>
                }
            }
        </Items>
    </DxMenu>
</div>

@code {
    private string? currentLocalPath;
    private HashSet<string> dovoljeniKljuci = new(StringComparer.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync() {
        currentLocalPath = new Uri(NavigationManager.Uri).LocalPath;
        NavigationManager.LocationChanged += OnLocationChanged;
        AuthService.OnAuthenticationStateChanged += OnAuthChanged;
        MenuDovoljenje.OnDovoljenjaSpremenjena += OnDovoljenjaSpremenjena;
        await NaloziDovoljenjaAsync();
    }

    /// <summary>
    /// Ali je postavka menija vidna za trenutnega uporabnika.
    /// Starš (s podmeniji) je viden, če ima dovoljenje IN vsaj enega vidnega otroka.
    /// </summary>
    private bool JeViden(MenuItemDef item) {
        if (item.ImaOtroke) {
            return dovoljeniKljuci.Contains(item.Kljuc) && item.Otroci.Any(JeViden);
        }
        return dovoljeniKljuci.Contains(item.Kljuc);
    }

    private async Task NaloziDovoljenjaAsync() {
        var user = AuthService.CurrentUser;
        dovoljeniKljuci = user != null
            ? await MenuDovoljenje.GetDovoljeniKljuciAsync(user.Id)
            : new HashSet<string>(StringComparer.OrdinalIgnoreCase);
    }

    private async void OnDovoljenjaSpremenjena() {
        await NaloziDovoljenjaAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async void OnAuthChanged() {
        await NaloziDovoljenjaAsync();
        await InvokeAsync(StateHasChanged);
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) {
        currentLocalPath = new Uri(NavigationManager.Uri).LocalPath;
        InvokeAsync(StateHasChanged);
    }

    private string? MenuItemCssClass(string? itemPath) {
        return string.Equals(currentLocalPath, itemPath, StringComparison.OrdinalIgnoreCase) ? "menu-item-active" : null;
    }

    public void Dispose() {
        NavigationManager.LocationChanged -= OnLocationChanged;
        AuthService.OnAuthenticationStateChanged -= OnAuthChanged;
        MenuDovoljenje.OnDovoljenjaSpremenjena -= OnDovoljenjaSpremenjena;
    }
}