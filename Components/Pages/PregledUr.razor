@page "/pregled-ur"
@rendermode InteractiveServer
@using ObracunDb.Data.DTOs
@using ObracunDb.Services
@using ObracunDb.Components
@inject ObracunService ObracunService
@inject ParametriService Parametri

<PageTitle>Pregled ur</PageTitle>

<style>
    .pregled-ur-grid {
        height: calc(100vh - 160px);
    }
</style>

<div class="d-flex align-items-center gap-2 mb-3">
    <span>Od:</span>
    <select class="form-select form-select-sm" style="width:auto;"
            value="@izbranoObdobjeOd" @onchange="OnObdobjeOdChanged">
        @foreach (var m in meseci)
        {
            <option value="@($"{m.Mesec:D2}/{m.Leto}")">@($"{m.Mesec:D2}/{m.Leto}")</option>
        }
    </select>
    <span>Do:</span>
    <select class="form-select form-select-sm" style="width:auto;"
            value="@izbranoObdobjeDo" @onchange="OnObdobjeDoChanged">
        @foreach (var m in meseci)
        {
            <option value="@($"{m.Mesec:D2}/{m.Leto}")">@($"{m.Mesec:D2}/{m.Leto}")</option>
        }
    </select>
    <DxButton Text="Naloži" Click="NaloziPodatke" RenderStyle="ButtonRenderStyle.Primary" />
</div>

@if (isLoading)
{
    <p>Nalagam podatke...</p>
}
else if (errorMessage != null)
{
    <div class="alert alert-danger">@errorMessage</div>
}
else if (podatki != null)
{
    <DxGrid Data="@podatki"
            ShowAllRows="true"
            CssClass="w-100 pregled-ur-grid"
            ShowFooter="true"
            ShowFilterRow="true"
            AllowSort="true"
            KeyFieldName="@nameof(PregledUrGridDto.Serviser)">
        <Columns>
            <DxGridDataColumn FieldName="@nameof(PregledUrGridDto.Serviser)" Caption="Šifra" Width="80px">
                <CellDisplayTemplate Context="c">
                    @{
                        var d = (PregledUrGridDto)c.DataItem;
                    }
                    <span style="cursor:pointer;"
                          @onclick="@(() => OpenPopup(d, PregledUrFilter.Vsi, ""))">@d.Serviser</span>
                </CellDisplayTemplate>
            </DxGridDataColumn>
            <DxGridDataColumn FieldName="@nameof(PregledUrGridDto.NazivServiserja)" Caption="Serviser">
                <CellDisplayTemplate Context="c">
                    @{
                        var d = (PregledUrGridDto)c.DataItem;
                    }
                    <span style="cursor:pointer;"
                          @onclick="@(() => OpenPopup(d, PregledUrFilter.Vsi, ""))">@d.NazivServiserja</span>
                </CellDisplayTemplate>
            </DxGridDataColumn>
            <DxGridDataColumn FieldName="@nameof(PregledUrGridDto.SteviloNalogov)" Caption="Št. nalogov" Width="110px">
                <CellDisplayTemplate Context="c">
                    @{
                        var d = (PregledUrGridDto)c.DataItem;
                    }
                    <span style="cursor:pointer;"
                          @onclick="@(() => OpenPopup(d, PregledUrFilter.Vsi, ""))">@d.SteviloNalogov</span>
                </CellDisplayTemplate>
            </DxGridDataColumn>
            <DxGridDataColumn FieldName="@nameof(PregledUrGridDto.SkupajUre)" Caption="Skupaj ure" Width="120px" DisplayFormat="N2">
                <CellDisplayTemplate Context="c">
                    @{
                        var d = (PregledUrGridDto)c.DataItem;
                    }
                    <span style="cursor:pointer;"
                          @onclick="@(() => OpenPopup(d, PregledUrFilter.Vsi, ""))">@d.SkupajUre.ToString("N2")</span>
                </CellDisplayTemplate>
            </DxGridDataColumn>
            <DxGridDataColumn FieldName="@nameof(PregledUrGridDto.UreNom)" Caption="Ure NOM" Width="120px" DisplayFormat="N2">
                <CellDisplayTemplate Context="c">
                    @{
                        var d = (PregledUrGridDto)c.DataItem;
                    }
                    <span style="cursor:pointer;"
                          @onclick="@(() => OpenPopup(d, PregledUrFilter.Nom, "NOM"))">@d.UreNom.ToString("N2")</span>
                </CellDisplayTemplate>
            </DxGridDataColumn>
            <DxGridDataColumn FieldName="@nameof(PregledUrGridDto.UrePartner23900)" Caption="Pos elektronček" Width="170px" DisplayFormat="N2">
                <CellDisplayTemplate Context="c">
                    @{
                        var d = (PregledUrGridDto)c.DataItem;
                    }
                    <span style="cursor:pointer;"
                          @onclick="@(() => OpenPopup(d, PregledUrFilter.Partner23900, "Pos elektronček"))">@d.UrePartner23900.ToString("N2")</span>
                </CellDisplayTemplate>
            </DxGridDataColumn>
            <DxGridBandColumn Caption="Ure stranke">
                <Columns>
                    <DxGridDataColumn FieldName="@nameof(PregledUrGridDto.UreStranke_7_16)" Caption="07-16" Width="90px" DisplayFormat="N2">
                        <CellDisplayTemplate Context="c">
                            @{
                                var d = (PregledUrGridDto)c.DataItem;
                            }
                            <span style="cursor:pointer;"
                                  @onclick="@(() => OpenPopup(d, PregledUrFilter.Stranke_7_16, "Stranke 07-16"))">@d.UreStranke_7_16.ToString("N2")</span>
                        </CellDisplayTemplate>
                    </DxGridDataColumn>
                    <DxGridDataColumn FieldName="@nameof(PregledUrGridDto.UreStranke_16_22)" Caption="16-22" Width="90px" DisplayFormat="N2">
                        <CellDisplayTemplate Context="c">
                            @{
                                var d = (PregledUrGridDto)c.DataItem;
                            }
                            <span style="cursor:pointer;"
                                  @onclick="@(() => OpenPopup(d, PregledUrFilter.Stranke_16_22, "Stranke 16-22"))">@d.UreStranke_16_22.ToString("N2")</span>
                        </CellDisplayTemplate>
                    </DxGridDataColumn>
                    <DxGridDataColumn FieldName="@nameof(PregledUrGridDto.UreStranke_22_7)" Caption="22-07" Width="90px" DisplayFormat="N2">
                        <CellDisplayTemplate Context="c">
                            @{
                                var d = (PregledUrGridDto)c.DataItem;
                            }
                            <span style="cursor:pointer;"
                                  @onclick="@(() => OpenPopup(d, PregledUrFilter.Stranke_22_7, "Stranke 22-07"))">@d.UreStranke_22_7.ToString("N2")</span>
                        </CellDisplayTemplate>
                    </DxGridDataColumn>
                    <DxGridDataColumn FieldName="@nameof(PregledUrGridDto.UreStranke)" Caption="Skupaj" Width="100px" DisplayFormat="N2">
                        <CellDisplayTemplate Context="c">
                            @{
                                var d = (PregledUrGridDto)c.DataItem;
                            }
                            <span style="cursor:pointer;"
                                  @onclick="@(() => OpenPopup(d, PregledUrFilter.StrankeVse, "Stranke skupaj"))">@d.UreStranke.ToString("N2")</span>
                        </CellDisplayTemplate>
                    </DxGridDataColumn>
                </Columns>
            </DxGridBandColumn>
        </Columns>
        <TotalSummary>
            <DxGridSummaryItem SummaryType="GridSummaryItemType.Count" FieldName="@nameof(PregledUrGridDto.Serviser)" DisplayText="Serviserjev: {0}" />
            <DxGridSummaryItem SummaryType="GridSummaryItemType.Sum" FieldName="@nameof(PregledUrGridDto.SteviloNalogov)" DisplayText="{0}" />
            <DxGridSummaryItem SummaryType="GridSummaryItemType.Sum" FieldName="@nameof(PregledUrGridDto.SkupajUre)" DisplayText="{0:N2}" />
            <DxGridSummaryItem SummaryType="GridSummaryItemType.Sum" FieldName="@nameof(PregledUrGridDto.UreNom)" DisplayText="{0:N2}" />
            <DxGridSummaryItem SummaryType="GridSummaryItemType.Sum" FieldName="@nameof(PregledUrGridDto.UrePartner23900)" DisplayText="{0:N2}" />
            <DxGridSummaryItem SummaryType="GridSummaryItemType.Sum" FieldName="@nameof(PregledUrGridDto.UreStranke_7_16)" DisplayText="{0:N2}" />
            <DxGridSummaryItem SummaryType="GridSummaryItemType.Sum" FieldName="@nameof(PregledUrGridDto.UreStranke_16_22)" DisplayText="{0:N2}" />
            <DxGridSummaryItem SummaryType="GridSummaryItemType.Sum" FieldName="@nameof(PregledUrGridDto.UreStranke_22_7)" DisplayText="{0:N2}" />
            <DxGridSummaryItem SummaryType="GridSummaryItemType.Sum" FieldName="@nameof(PregledUrGridDto.UreStranke)" DisplayText="{0:N2}" />
        </TotalSummary>
    </DxGrid>
}

<PregledUrNalogiPopup @bind-Visible="popupVisible"
                      LetoOd="@popupLetoOd"
                      MesecOd="@popupMesecOd"
                      LetoDo="@popupLetoDo"
                      MesecDo="@popupMesecDo"
                      Serviser="@popupServiser"
                      NazivServiserja="@popupNazivServiserja"
                      Filter="@popupFilter"
                      FilterOpis="@popupFilterOpis" />

@code {
    int mesecOd;
    int letoOd;
    int mesecDo;
    int letoDo;
    string izbranoObdobjeOd = "";
    string izbranoObdobjeDo = "";
    List<(int Leto, int Mesec)> meseci = new();
    List<PregledUrGridDto>? podatki;
    bool isLoading;
    string? errorMessage;

    // Popup state
    bool popupVisible;
    int popupLetoOd;
    int popupMesecOd;
    int popupLetoDo;
    int popupMesecDo;
    string popupServiser = "";
    string? popupNazivServiserja;
    PregledUrFilter popupFilter = PregledUrFilter.Vsi;
    string? popupFilterOpis;

    void OpenPopup(PregledUrGridDto d, PregledUrFilter filter, string filterOpis)
    {
        popupLetoOd = letoOd;
        popupMesecOd = mesecOd;
        popupLetoDo = letoDo;
        popupMesecDo = mesecDo;
        popupServiser = d.Serviser;
        popupNazivServiserja = d.NazivServiserja;
        popupFilter = filter;
        popupFilterOpis = filterOpis;
        popupVisible = true;
    }

    protected override void OnInitialized()
    {
        // Default = pretekli mesec
        var prejsnji = DateTime.Today.AddMonths(-1);
        letoOd = letoDo = prejsnji.Year;
        mesecOd = mesecDo = prejsnji.Month;
        izbranoObdobjeOd = izbranoObdobjeDo = $"{mesecOd:D2}/{letoOd}";

        // Sestavi seznam mesecev (zadnjih 24 mesecev)
        meseci = new();
        var d = DateTime.Today;
        for (int i = 0; i < 24; i++)
        {
            meseci.Add((d.Year, d.Month));
            d = d.AddMonths(-1);
        }
    }

    void OnObdobjeOdChanged(ChangeEventArgs e)
    {
        var val = e.Value?.ToString() ?? "";
        if (TryParseObdobje(val, out var l, out var m))
        {
            mesecOd = m;
            letoOd = l;
            izbranoObdobjeOd = val;
        }
    }

    void OnObdobjeDoChanged(ChangeEventArgs e)
    {
        var val = e.Value?.ToString() ?? "";
        if (TryParseObdobje(val, out var l, out var m))
        {
            mesecDo = m;
            letoDo = l;
            izbranoObdobjeDo = val;
        }
    }

    static bool TryParseObdobje(string val, out int leto, out int mesec)
    {
        leto = 0;
        mesec = 0;
        var parts = val.Split('/');
        return parts.Length == 2
            && int.TryParse(parts[0], out mesec)
            && int.TryParse(parts[1], out leto);
    }

    void NormalizeRange()
    {
        var od = new DateTime(letoOd, mesecOd, 1);
        var doDatum = new DateTime(letoDo, mesecDo, 1);
        if (od <= doDatum) return;

        (letoOd, letoDo) = (letoDo, letoOd);
        (mesecOd, mesecDo) = (mesecDo, mesecOd);
        izbranoObdobjeOd = $"{mesecOd:D2}/{letoOd}";
        izbranoObdobjeDo = $"{mesecDo:D2}/{letoDo}";
    }

    async Task NaloziPodatke()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            NormalizeRange();
            podatki = await ObracunService.GetPregledUrAsync(letoOd, mesecOd, letoDo, mesecDo);
        }
        catch (Exception ex)
        {
            errorMessage = $"Napaka: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }
}
