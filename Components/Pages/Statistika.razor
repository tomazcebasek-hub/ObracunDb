@page "/statistika"
@using ObracunDb.Data.DTOs
@using ObracunDb.Services
@inject PredracunService PredracunService
@inject NavigationManager Navigation

<PageTitle>Statistika</PageTitle>

@if (isLoading)
{
    <p>Nalagam podatke...</p>
}
else
{
    <div style="display:flex; flex-direction:column; flex:1; min-height:0; overflow:auto; gap:24px; padding-bottom:8px;">
        <div style="min-height:350px;">
            <DxChart Data="@statistika" Height="350px">
                <DxChartTitle Text="Kolièina predraèunov po mesecih" />
                <DxChartCommonSeries NameField="@((PredracunStatistikaDto s) => s.Stanje)"
                                     ArgumentField="@(s => s.Mesec)"
                                     ValueField="@(s => s.Kolicina)"
                                     SeriesType="ChartSeriesType.StackedBar" />
                <DxChartArgumentAxis>
                    <DxChartAxisLabel RotationAngle="-45" />
                </DxChartArgumentAxis>
                <DxChartLegend Position="RelativePosition.Outside"
                               HorizontalAlignment="HorizontalAlignment.Right" />
                <DxChartTooltip Enabled="true">
                    <div style="padding:4px 8px;">
                        <b>@context.Point.SeriesName</b><br />
                        @context.Point.Argument: @context.Point.Value kos
                    </div>
                </DxChartTooltip>
            </DxChart>
        </div>

        <div style="min-height:350px;">
            <DxChart Data="@statistika" Height="350px">
                <DxChartTitle Text="Zneski predraèunov po mesecih" />
                <DxChartCommonSeries NameField="@((PredracunStatistikaDto s) => s.Stanje)"
                                     ArgumentField="@(s => s.Mesec)"
                                     ValueField="@(s => s.Znesek)"
                                     SeriesType="ChartSeriesType.StackedBar" />
                <DxChartArgumentAxis>
                    <DxChartAxisLabel RotationAngle="-45" />
                </DxChartArgumentAxis>
                <DxChartLegend Position="RelativePosition.Outside"
                               HorizontalAlignment="HorizontalAlignment.Right" />
                <DxChartTooltip Enabled="true">
                    <div style="padding:4px 8px;">
                        <b>@context.Point.SeriesName</b><br />
                        @context.Point.Argument: @($"{context.Point.Value:N2}") €
                    </div>
                </DxChartTooltip>
            </DxChart>
        </div>

        <div class="d-flex gap-2 align-items-center" style="flex-shrink:0;">
            <DxButton Text="Nazaj"
                      Click="@(() => Navigation.NavigateTo("/predracuni"))"
                      RenderStyle="ButtonRenderStyle.Secondary" />
        </div>
    </div>
}

@code {
    List<PredracunStatistikaDto> statistika = new();
    bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var predracuni = await PredracunService.GetAllPredracuniAsync(odLeta: 2025);

            statistika = predracuni
                .Where(p => p.Datum != null)
                .GroupBy(p => new
                {
                    Leto = p.Datum!.Value.Year,
                    Mesec = p.Datum!.Value.Month,
                    Stanje = string.IsNullOrEmpty(p.StanjePrikaz) ? "Ostalo" : p.StanjePrikaz
                })
                .Select(g => new PredracunStatistikaDto
                {
                    MesecDatum = new DateTime(g.Key.Leto, g.Key.Mesec, 1),
                    Mesec = $"{g.Key.Mesec}/{g.Key.Leto}",
                    Stanje = g.Key.Stanje,
                    Kolicina = g.Count(),
                    Znesek = g.Sum(p => p.ZnesekKoncni ?? 0)
                })
                .OrderBy(s => s.MesecDatum)
                .ThenBy(s => s.Stanje)
                .ToList();
        }
        finally
        {
            isLoading = false;
        }
    }
}
