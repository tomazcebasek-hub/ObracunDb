@page "/reklamacije"
@using ObracunDb.Data.DTOs
@using ObracunDb.Data.Entities
@using ObracunDb.Services
@using Microsoft.AspNetCore.Components.Sections
@inject ReklamacijeService ReklamacijeService
@inject UporabnikService UporabnikService
@inject AuthService AuthService

<PageTitle>Reklamacije</PageTitle>
<SectionContent SectionName="PageHeaderExtra">
    <div style="display:grid; grid-template-columns:auto auto auto 220px auto 200px; column-gap:8px; align-items:center; margin-left:1rem; white-space:nowrap;">
        <DxButton Text="Prikaži tudi rešene"
                  Click="@TogglePrikaziResene"
                  RenderStyle="@(filterPrikaziResene ? ButtonRenderStyle.Primary : ButtonRenderStyle.Secondary)"
                  SizeMode="SizeMode.Small" />
        <DxButton Text="Samo moji"
                  Click="@ToggleSamoMoji"
                  RenderStyle="@(filterSamoMoji ? ButtonRenderStyle.Primary : ButtonRenderStyle.Secondary)"
                  SizeMode="SizeMode.Small" />
        <label style="white-space:nowrap; margin-bottom:0;">Kdo naj obdela:</label>
        <DxComboBox Data="@kdoNajObdelaFilterOptions"
                    @bind-Value="@filterKdoNajObdela"
                    NullText="Vsi"
                    ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                    Style="width:220px; min-width:220px; max-width:220px;"
                    SizeMode="SizeMode.Small"
                    FilteringMode="DataGridFilteringMode.Contains" />
        <label style="white-space:nowrap; margin-bottom:0;">Tip:</label>
        <DxComboBox Data="@tipiFilterOptions"
                    @bind-Value="@filterTip"
                    TextFieldName="Naziv"
                    ValueFieldName="Tip"
                    NullText="Vsi"
                    ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                    Style="width:200px; min-width:200px; max-width:200px;"
                    SizeMode="SizeMode.Small" />
    </div>
</SectionContent>

<style>
    .action-btn {
        color: #4fc3f7 !important;
        font-size: 16px;
        cursor: pointer;
        padding: 4px 8px;
    }
    .action-btn:hover {
        color: #81d4fa !important;
    }
    .action-btn-danger {
        color: #e57373 !important;
        font-size: 16px;
        cursor: pointer;
        padding: 4px 8px;
    }
    .action-btn-danger:hover {
        color: #ef9a9a !important;
    }
    .action-btn-success {
        color: #81c784 !important;
        font-size: 16px;
        cursor: pointer;
        padding: 4px 8px;
    }
    .action-btn-success:hover {
        color: #a5d6a7 !important;
    }
</style>

@if (isLoading)
{
    <div style="position:fixed; inset:0; background:rgba(0,0,0,0.35); display:flex; align-items:center; justify-content:center; z-index:2000;">
        <div style="display:flex; flex-direction:column; align-items:center; gap:14px; padding:24px 36px; background:white; color:#333; border-radius:8px; box-shadow:0 4px 24px rgba(0,0,0,0.3); min-width:320px;">
            <div style="width:42px; height:42px; border:4px solid #e0e0e0; border-top-color:#4169E1; border-radius:50%; animation:reklamacije-spin 0.8s linear infinite;"></div>
            <div>@loadingMessage</div>
        </div>
    </div>
}
else
{
    <div style="display:flex; flex-direction:column; flex:1; min-height:0; height:calc(100vh - 120px); gap:8px;">
        <div style="flex:1 1 50%; min-height:0;">
            <DxGrid Data="@filteredGridData"
                    KeyFieldName="@nameof(ReklamacijaGridDto.Id)"
                    ShowFilterRow="true"
                    PageSize="int.MaxValue"
                    PagerVisible="false"
                    FocusedRowEnabled="true"
                    RowClick="@OnReklamacijaRowClick"
                    CustomizeElement="@CustomizeReklamacijeGridElement"
                    CssClass="w-100 h-100">
                <Columns>
                    <DxGridDataColumn FieldName="@nameof(ReklamacijaGridDto.TipReklamacijeNaziv)" Caption="Tip" Width="150px" />
                    <DxGridDataColumn FieldName="@nameof(ReklamacijaGridDto.PartnerDisplay)" Caption="Partner" MinWidth="180" />
                    <DxGridDataColumn FieldName="@nameof(ReklamacijaGridDto.DatumZahteve)" Caption="Datum zahteve" DisplayFormat="dd.MM.yyyy" Width="130px" />
                    <DxGridDataColumn FieldName="@nameof(ReklamacijaGridDto.StevilkePogodb)" Caption="Številke pogodb" Width="170px" />
                    <DxGridDataColumn FieldName="@nameof(ReklamacijaGridDto.Kontakt)" Caption="Kontakt" Width="180px" />
                    <DxGridDataColumn FieldName="@nameof(ReklamacijaGridDto.TipPrekinitve)" Caption="Tip prekinitve" Width="170px" />
                    <DxGridDataColumn FieldName="@nameof(ReklamacijaGridDto.RacuniDoDne)" Caption="Računi do dne" DisplayFormat="dd.MM.yyyy" Width="130px" />
                    <DxGridDataColumn FieldName="@nameof(ReklamacijaGridDto.Opis)" Caption="Opis" Width="200px" />
                    <DxGridDataColumn FieldName="@nameof(ReklamacijaGridDto.KdoNajObdela)" Caption="Kdo naj obdela" Width="150px" />
                    <DxGridDataColumn FieldName="@nameof(ReklamacijaGridDto.DatumPosredovanja)" Caption="Datum posredovanja" DisplayFormat="dd.MM.yyyy HH:mm" Width="160px" />
                    <DxGridDataColumn FieldName="@nameof(ReklamacijaGridDto.SteviloVnosov)" Caption="Št. vnosov" Width="100px" />
                    <DxGridDataColumn Caption="Akcije" Width="200px" FixedPosition="GridColumnFixedPosition.Right">
                        <CellDisplayTemplate>
                            @{
                                var item = (ReklamacijaGridDto)context.DataItem;
                            }
                            <span class="action-btn" @onclick="@(() => ShowPrilogeDialog(item))" title="Priponke">📎</span>
                            <span class="action-btn" @onclick="@(() => ShowEditDialog(item))" title="Popravi">✎</span>
                            <span class="action-btn-success" @onclick="@(() => ShowZapisFawDialog(item))" title="Zapis v FAW">↗</span>
                            <span class="action-btn-danger" @onclick="@(() => ShowDeleteConfirm(item))" title="Izbriši">×</span>
                        </CellDisplayTemplate>
                    </DxGridDataColumn>
                </Columns>
            </DxGrid>
        </div>

        <div style="flex:1 1 50%; min-height:0; display:flex; gap:8px;">
            <div style="flex:0 0 35%; min-width:0; display:flex; flex-direction:column;">
                <div style="flex:1; min-height:0; border:1px solid #ddd; border-radius:4px; padding:10px; overflow:auto;">
                    <div style="margin-bottom:10px;"><strong>Podatki</strong></div>
                    @if (selectedReklamacija == null)
                    {
                        <p class="text-muted">Izberite reklamacijo v zgornjem gridu.</p>
                    }
                    else
                    {
                        <div><strong>Partner:</strong> @selectedReklamacija.PartnerDisplay</div>
                        <div><strong>Računi do dne:</strong> @(selectedReklamacija.RacuniDoDne?.ToString("dd.MM.yyyy") ?? "")</div>
                    }
                </div>
                <div style="flex-shrink:0; padding-top:8px; min-height:38px; display:flex; align-items:flex-end; flex-wrap:wrap; gap:8px;">
                    @foreach (var tip in Enum.GetValues<TipReklamacije>())
                    {
                        <DxButton Text="@($"Vnos: {TipNaziv(tip)}")"
                                  Click="@(() => ShowAddDialog(tip))"
                                  RenderStyle="ButtonRenderStyle.Success"
                                  SizeMode="SizeMode.Small" />
                    }
                    <DxButton Text="Statusi"
                              Click="@ShowStatusiDialog"
                              RenderStyle="ButtonRenderStyle.Secondary"
                              SizeMode="SizeMode.Small" />
                </div>
            </div>
            <div style="flex:1; min-width:0; display:flex; flex-direction:column;">
                <div style="flex:1; min-height:0;">
                    <DxGrid Data="@selectedPostavke"
                            PageSize="int.MaxValue"
                            PagerVisible="false"
                            CssClass="w-100 h-100">
                        <Columns>
                            <DxGridDataColumn FieldName="@nameof(ReklamacijaPostavkaDto.Datum)" Caption="Datum" DisplayFormat="dd.MM.yyyy HH:mm" Width="150px" />
                            <DxGridDataColumn FieldName="@nameof(ReklamacijaPostavkaDto.Uporabnik)" Caption="Uporabnik" Width="140px" />
                            <DxGridDataColumn FieldName="@nameof(ReklamacijaPostavkaDto.Komentar)" Caption="Komentar" />
                        </Columns>
                    </DxGrid>
                </div>
                <div style="flex-shrink:0; padding-top:8px; min-height:38px; display:flex; align-items:flex-end;">
                    <DxButton Text="Nov vnos"
                              Click="@ShowPostavkaForSelected"
                              RenderStyle="ButtonRenderStyle.Success"
                              SizeMode="SizeMode.Small" />
                </div>
            </div>
        </div>
    </div>
}

<DxPopup @bind-Visible="@showDialog"
         HeaderText="@dialogTitle"
         Width="96vw"
         Height="92vh"
         ShowFooter="true"
         CloseOnEscape="true">
    <BodyContentTemplate>
        <div style="display:flex; gap:18px; align-items:flex-start; height:calc(92vh - 110px); min-height:0;">
        <div style="flex:0 0 33%; min-width:0; overflow:auto;">
        <div class="mb-3" style="display:flex; align-items:center; gap:12px;">
            <label style="min-width:150px; white-space:nowrap;">Tip</label>
            <strong>@TipNaziv(editTipReklamacije)</strong>
        </div>
        <div class="mb-3" style="display:flex; align-items:center; gap:12px;">
            <label style="min-width:150px; white-space:nowrap;">Partner</label>
            <DxComboBox Data="@vsiPartnerji"
                        @bind-Value="@editPartner"
                        TextFieldName="DisplayName"
                        ValueFieldName="Sifra"
                        NullText="Izberi partnerja..."
                        CssClass="w-100"
                        ListRenderMode="ListRenderMode.Virtual"
                        FilteringMode="DataGridFilteringMode.Contains" />
        </div>
        @if (editTipReklamacije == TipReklamacije.PrekinitevPogodbe)
        {
            <div class="mb-3">
                <div class="mb-2" style="font-weight:600;">Veljavne pogodbe</div>
                @if (loadingPogodbe)
                {
                    <p class="text-muted">Nalagam pogodbe...</p>
                }
                else if (pogodbe.Count == 0)
                {
                    <p class="text-muted">Za izbranega partnerja ni veljavnih pogodb.</p>
                }
                else
                {
                    <DxGrid Data="@pogodbe"
                            KeyFieldName="@nameof(PogodbaZaReklamacijoDto.DisplayStevilka)"
                            PageSize="int.MaxValue"
                            PagerVisible="false"
                            CssClass="w-100"
                            style="max-height:300px;">
                        <Columns>
                            <DxGridDataColumn Caption="Prekini" Width="80px">
                                <CellDisplayTemplate Context="contractContext">
                                    @{
                                        var pogodba = (PogodbaZaReklamacijoDto)contractContext.DataItem;
                                    }
                                    <DxCheckBox @bind-Checked="@pogodba.Prekini" />
                                </CellDisplayTemplate>
                            </DxGridDataColumn>
                            <DxGridDataColumn FieldName="@nameof(PogodbaZaReklamacijoDto.DisplayStevilka)" Caption="Številka" Width="150px" />
                            <DxGridDataColumn FieldName="@nameof(PogodbaZaReklamacijoDto.Znesek)" Caption="Znesek" DisplayFormat="N2" Width="120px" />
                            <DxGridDataColumn FieldName="@nameof(PogodbaZaReklamacijoDto.VeljaDo)" Caption="Velja do" DisplayFormat="dd.MM.yyyy" Width="130px" />
                        </Columns>
                    </DxGrid>
                }
            </div>
        }
        <div class="mb-3" style="display:flex; align-items:center; gap:12px;">
            <label style="min-width:150px; white-space:nowrap;">Kontakt</label>
            <DxTextBox @bind-Text="@editKontakt" CssClass="w-100" />
        </div>
        @if (editTipReklamacije == TipReklamacije.PrekinitevPogodbe)
        {
            <div class="mb-3" style="display:flex; align-items:center; gap:12px;">
                <label style="min-width:150px; white-space:nowrap;">Razlog prekinitve</label>
                <DxTextBox @bind-Text="@editTipPrekinitve" CssClass="w-100" />
            </div>
            <div class="mb-3" style="display:flex; align-items:center; gap:12px;">
                <label style="min-width:150px; white-space:nowrap;">Računi do datuma</label>
                <DxDateEdit @bind-Date="@editRacuniDoDne" DisplayFormat="dd.MM.yyyy" CssClass="w-100" />
            </div>
        }
        else
        {
            <div class="mb-3" style="display:flex; align-items:flex-start; gap:12px;">
                <label style="min-width:150px; white-space:nowrap; padding-top:6px;">Opis</label>
                <DxMemo @bind-Text="@editOpis" Rows="3" CssClass="w-100" />
            </div>
        }
        @if (!editingId.HasValue)
        {
            <div class="mb-3" style="display:flex; align-items:flex-start; gap:12px;">
                <label style="min-width:150px; white-space:nowrap; padding-top:6px;">Komentar</label>
                <DxMemo @bind-Text="@editKomentar" Rows="3" CssClass="w-100" />
            </div>
            <div class="mb-3" style="display:flex; align-items:center; gap:12px;">
                <label style="min-width:150px; white-space:nowrap;">Kdo naj obdela</label>
                <DxComboBox Data="@uporabniki"
                            @bind-Value="@editKdoNajObdela"
                            TextFieldName="UporabniskoIme"
                            ValueFieldName="UporabniskoIme"
                            NullText="Izberi uporabnika..."
                            ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                            CssClass="w-100"
                            FilteringMode="DataGridFilteringMode.Contains" />
            </div>
            @if (string.IsNullOrWhiteSpace(editKdoNajObdela))
            {
                <div class="mb-3" style="display:flex; align-items:center; gap:12px;">
                    <label style="min-width:150px; white-space:nowrap;">Status</label>
                    <DxComboBox Data="@statusi"
                                @bind-Value="@editStatusId"
                                TextFieldName="Naziv"
                                ValueFieldName="Id"
                                NullText="Izberi status..."
                                CssClass="w-100"
                                FilteringMode="DataGridFilteringMode.Contains" />
                </div>
            }
        }
        </div>
        <div style="flex:1; min-width:0;">
            <ReklamacijePrilogePanel IdReklamacija="@editingId"
                                     PendingPriloge="@pendingPriloge"
                                     Height="calc(92vh - 110px)" />
        </div>
        </div>
    </BodyContentTemplate>
    <FooterContentTemplate>
        @if (!string.IsNullOrEmpty(dialogError))
        {
            <span class="text-danger me-auto" style="font-size:0.85rem;">@dialogError</span>
        }
        <DxButton Text="Shrani"
                  Click="@SaveData"
                  RenderStyle="ButtonRenderStyle.Primary" />
        <DxButton Text="Prekliči"
                  Click="@(() => { showDialog = false; dialogError = null; })"
                  RenderStyle="ButtonRenderStyle.Secondary" />
    </FooterContentTemplate>
</DxPopup>

<DxPopup @bind-Visible="@showPostavkaDialog"
         HeaderText="Nov vnos"
         Width="96vw"
         Height="92vh"
         ShowFooter="true"
         CloseOnEscape="true">
    <BodyContentTemplate>
        <div style="display:flex; gap:18px; align-items:flex-start; height:calc(92vh - 110px); min-height:0;">
        <div style="flex:0 0 33%; min-width:0; overflow:auto;">
        <div class="mb-3" style="display:flex; align-items:flex-start; gap:12px;">
            <label style="min-width:140px; white-space:nowrap; padding-top:6px;">Komentar</label>
            <DxMemo @bind-Text="@postavkaKomentar" Rows="4" CssClass="w-100" />
        </div>
        <div class="mb-3" style="display:flex; align-items:center; gap:12px;">
            <label style="min-width:140px; white-space:nowrap;">Kdo naj obdela</label>
            <DxComboBox Data="@uporabniki"
                        @bind-Value="@postavkaKdoNajObdela"
                        TextFieldName="UporabniskoIme"
                        ValueFieldName="UporabniskoIme"
                        NullText="Izberi uporabnika..."
                        ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                        CssClass="w-100"
                        FilteringMode="DataGridFilteringMode.Contains" />
        </div>
        @if (string.IsNullOrWhiteSpace(postavkaKdoNajObdela))
        {
            <div class="mb-3" style="display:flex; align-items:center; gap:12px;">
                <label style="min-width:140px; white-space:nowrap;">Status</label>
                <DxComboBox Data="@statusi"
                            @bind-Value="@postavkaStatusId"
                            TextFieldName="Naziv"
                            ValueFieldName="Id"
                            NullText="Izberi status..."
                            CssClass="w-100"
                            FilteringMode="DataGridFilteringMode.Contains" />
            </div>
        }
        </div>
        <div style="flex:1; min-width:0;">
            <ReklamacijePrilogePanel IdReklamacija="@postavkaIdReklamacija"
                                     PendingPriloge="@postavkaPendingPriloge"
                                     Height="calc(92vh - 110px)" />
        </div>
        </div>
    </BodyContentTemplate>
    <FooterContentTemplate>
        @if (!string.IsNullOrEmpty(postavkaDialogError))
        {
            <span class="text-danger me-auto" style="font-size:0.85rem;">@postavkaDialogError</span>
        }
        <DxButton Text="Shrani"
                  Click="@SavePostavka"
                  RenderStyle="ButtonRenderStyle.Primary" />
        <DxButton Text="Prekliči"
                  Click="@(() => { showPostavkaDialog = false; postavkaDialogError = null; })"
                  RenderStyle="ButtonRenderStyle.Secondary" />
    </FooterContentTemplate>
</DxPopup>

<DxPopup @bind-Visible="@showStatusiDialog"
         HeaderText="Statusi reklamacij"
         Width="760px"
         ShowFooter="true"
         CloseOnEscape="true">
    <BodyContentTemplate>
        <div style="display:flex; gap:16px; min-height:420px;">
            <div style="flex:1; min-width:0;">
                <DxGrid Data="@statusi"
                        KeyFieldName="@nameof(ReklamacijaStatusSifrantDto.Id)"
                        ShowAllRows="true"
                        RowClick="@OnStatusRowClick"
                        CustomizeElement="@CustomizeStatusGridElement"
                        CssClass="w-100">
                    <Columns>
                        <DxGridDataColumn FieldName="@nameof(ReklamacijaStatusSifrantDto.Naziv)" Caption="Naziv" />
                        <DxGridDataColumn FieldName="@nameof(ReklamacijaStatusSifrantDto.Barva)" Caption="Barva" Width="120px">
                            <CellDisplayTemplate Context="barvaContext">
                                @{
                                    var status = (ReklamacijaStatusSifrantDto)barvaContext.DataItem;
                                }
                                <span style="display:inline-block; width:42px; height:18px; border:1px solid #ccc; background:@status.Barva;"></span>
                            </CellDisplayTemplate>
                        </DxGridDataColumn>
                    </Columns>
                </DxGrid>
            </div>
            @if (statusEditVisible)
            {
                <div style="flex:0 0 300px; min-width:0; display:flex; flex-direction:column; gap:10px;">
                    <DxTextBox @bind-Text="@statusNaziv" NullText="Naziv" />
                    <div style="display:grid; grid-template-columns:repeat(6, 1fr); gap:6px;">
                        @foreach (var barva in statusBarve)
                        {
                            <button type="button" title="@barva" @onclick="@(() => statusBarva = barva)"
                                    style="height:28px; border:@(statusBarva == barva ? "2px solid #333" : "1px solid #bbb"); border-radius:4px; background:@barva;"></button>
                        }
                    </div>
                    <div style="display:flex; align-items:center; gap:8px;">
                        <span>Izbrana:</span>
                        <span style="display:inline-block; width:42px; height:24px; border:1px solid #ccc; background:@statusBarva;"></span>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(statusiError))
                    {
                        <div class="text-danger">@statusiError</div>
                    }
                    <div style="margin-top:auto; display:flex; gap:8px;">
                        <DxButton Text="Shrani" Click="@SaveStatus" RenderStyle="ButtonRenderStyle.Primary" />
                        <DxButton Text="Prekliči" Click="@CancelStatusEdit" RenderStyle="ButtonRenderStyle.Secondary" />
                        <DxButton Text="Izbriši" Click="@DeleteStatus" RenderStyle="ButtonRenderStyle.Danger" Enabled="@(statusId.HasValue)" />
                    </div>
                </div>
            }
        </div>
    </BodyContentTemplate>
    <FooterContentTemplate>
        <DxButton Text="Nov" Click="@NewStatus" RenderStyle="ButtonRenderStyle.Primary" />
        <DxButton Text="Zapri" RenderStyle="ButtonRenderStyle.Secondary" Click="@(() => showStatusiDialog = false)" />
    </FooterContentTemplate>
</DxPopup>

<DxPopup @bind-Visible="@showPrilogeDialog"
         HeaderText="@prilogeDialogTitle"
         Width="96vw"
         Height="92vh"
         AllowDrag="true"
         CloseOnEscape="true">
    <BodyContentTemplate>
        <ReklamacijePrilogePanel IdReklamacija="@prilogeIdReklamacija"
                                 PendingPriloge="@prilogePendingPriloge"
                                 Height="calc(92vh - 110px)" />
    </BodyContentTemplate>
</DxPopup>

<DxPopup @bind-Visible="@showZapisFawDialog"
         HeaderText="Zapis v FAW"
         Width="760px"
         ShowFooter="true"
         CloseOnEscape="true">
    <BodyContentTemplate>
        @if (!string.IsNullOrEmpty(zapisFawError))
        {
            <div class="alert alert-danger">@zapisFawError</div>
        }
        else if (zapisFawPreview != null)
        {
            <div class="mb-2">
                <strong>Partner:</strong> @zapisFawPreview.Partner - @zapisFawPreview.NazivPartnerja<br />
                <strong>Računi do dne:</strong> @zapisFawPreview.RacuniDoDne.ToString("dd.MM.yyyy")
            </div>
            <DxGrid Data="@zapisFawPreview.Pogodbe"
                    KeyFieldName="@nameof(ReklamacijaFawPogodbaDto.DisplayStevilka)"
                    PageSize="int.MaxValue"
                    PagerVisible="false"
                    CssClass="w-100">
                <Columns>
                    <DxGridDataColumn FieldName="@nameof(ReklamacijaFawPogodbaDto.DisplayStevilka)" Caption="Pogodba" />
                    <DxGridDataColumn FieldName="@nameof(ReklamacijaFawPogodbaDto.StariDatumVeljavnosti)" Caption="Stara veljavnost" DisplayFormat="dd.MM.yyyy" Width="150px" />
                    <DxGridDataColumn FieldName="@nameof(ReklamacijaFawPogodbaDto.NoviDatumVeljavnosti)" Caption="Nova veljavnost" DisplayFormat="dd.MM.yyyy" Width="150px" />
                </Columns>
            </DxGrid>
            <p class="mt-3 mb-0">Potrdite zapis novih datumov veljavnosti v FAW.</p>
        }
        else
        {
            <p class="text-muted">Nalagam...</p>
        }
    </BodyContentTemplate>
    <FooterContentTemplate>
        <DxButton Text="Potrdi in zapiši"
                  Click="@PotrdiZapisFaw"
                  RenderStyle="ButtonRenderStyle.Primary"
                  Enabled="@(zapisFawPreview != null && string.IsNullOrEmpty(zapisFawError))" />
        <DxButton Text="Prekliči"
                  Click="@(() => showZapisFawDialog = false)"
                  RenderStyle="ButtonRenderStyle.Secondary" />
    </FooterContentTemplate>
</DxPopup>

<DxPopup @bind-Visible="@showDeleteDialog"
         HeaderText="Potrditev brisanja"
         Width="430px"
         ShowFooter="true"
         CloseOnEscape="true">
    <BodyContentTemplate>
        <p>Ali ste prepričani, da želite izbrisati reklamacije za partnerja @deletePartnerNaziv?</p>
    </BodyContentTemplate>
    <FooterContentTemplate>
        <DxButton Text="Izbriši"
                  Click="@DeleteData"
                  RenderStyle="ButtonRenderStyle.Danger" />
        <DxButton Text="Prekliči"
                  Click="@(() => showDeleteDialog = false)"
                  RenderStyle="ButtonRenderStyle.Secondary" />
    </FooterContentTemplate>
</DxPopup>

@code {
    List<ReklamacijaGridDto>? gridData;
    List<PartnerReklamacijaDto>? vsiPartnerji;
    List<UporabnikGridDto> uporabniki = new();
    List<PogodbaZaReklamacijoDto> pogodbe = new();
    bool isLoading = true;
    string loadingMessage = "Začenjam nalaganje...";
    bool loadingPogodbe;
    bool filterPrikaziResene;
    bool filterSamoMoji;
    string? filterKdoNajObdela;
    TipReklamacije? filterTip;
    ReklamacijaGridDto? selectedReklamacija;
    List<ReklamacijaPostavkaDto> selectedPostavke = new();

    static string TipNaziv(TipReklamacije tip) => tip switch
    {
        TipReklamacije.PrekinitevPogodbe => "Prekinitev pogodbe",
        TipReklamacije.Reklamacija => "Reklamacija",
        _ => tip.ToString()
    };

    static readonly List<TipFilterOption> tipiFilterOptions =
        Enum.GetValues<TipReklamacije>()
            .Select(t => new TipFilterOption { Tip = t, Naziv = TipNaziv(t) })
            .ToList();

    class TipFilterOption
    {
        public TipReklamacije Tip { get; set; }
        public string Naziv { get; set; } = string.Empty;
    }

    List<string> kdoNajObdelaFilterOptions => uporabniki
        .Where(u => u.Aktiven)
        .Select(u => u.UporabniskoIme)
        .Concat(gridData?.Select(r => r.KdoNajObdela).Where(k => !string.IsNullOrWhiteSpace(k)).Cast<string>() ?? Enumerable.Empty<string>())
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(u => u)
        .ToList();

    List<ReklamacijaGridDto>? filteredGridData => gridData?
        .Where(r => filterPrikaziResene || !string.IsNullOrWhiteSpace(r.KdoNajObdela))
        .Where(r => !filterSamoMoji || string.Equals(r.KdoNajObdela, AuthService.CurrentUser?.UporabniskoIme, StringComparison.OrdinalIgnoreCase))
        .Where(r => string.IsNullOrWhiteSpace(filterKdoNajObdela) || string.Equals(r.KdoNajObdela, filterKdoNajObdela, StringComparison.OrdinalIgnoreCase))
        .Where(r => filterTip == null || r.TipReklamacije == filterTip)
        .ToList();

    bool showDialog;
    string dialogTitle = string.Empty;
    string? dialogError;
    int? editingId;
    int _editPartner;
    bool suppressPartnerChanged;
    int editPartner
    {
        get => _editPartner;
        set
        {
            if (_editPartner == value)
                return;

            _editPartner = value;
            if (!suppressPartnerChanged)
                _ = InvokeAsync(() => OnPartnerChanged(value));
        }
    }
    string? editKontakt;
    string? editTipPrekinitve;
    DateTime? editRacuniDoDne;
    string? editKomentar;
    string? editKdoNajObdela;
    int? editStatusId;
    TipReklamacije editTipReklamacije = TipReklamacije.PrekinitevPogodbe;
    string? editOpis;
    List<ReklamacijaPrilogaVnosDto> pendingPriloge = new();

    bool showPostavkaDialog;
    int? postavkaIdReklamacija;
    string? postavkaKomentar;
    string? postavkaKdoNajObdela;
    int? postavkaStatusId;
    string? postavkaDialogError;
    List<ReklamacijaPrilogaVnosDto> postavkaPendingPriloge = new();

    bool showStatusiDialog;
    List<ReklamacijaStatusSifrantDto> statusi = new();
    bool statusEditVisible;
    int? statusId;
    string statusNaziv = string.Empty;
    string statusBarva = "#F5F5F5";
    string? statusiError;
    readonly string[] statusBarve =
    [
        "#F5F5F5", "#FDECEC", "#FFF1E6", "#FFF7D6", "#F3F8D7", "#EAF7E9",
        "#E7F7F1", "#E6F4FA", "#EAF0FF", "#F1ECFF", "#F8EAF7", "#FBEAF0",
        "#EDE7F6", "#E3F2FD", "#E0F7FA", "#E0F2F1", "#E8F5E9", "#F1F8E9",
        "#FFFDE7", "#FFF8E1", "#FBE9E7", "#EFEBE9", "#ECEFF1", "#F0F4C3",
        "#DCEDC8", "#D7CCC8", "#CFD8DC", "#D1C4E9", "#BBDEFB", "#B2DFDB"
    ];

    bool showPrilogeDialog;
    int? prilogeIdReklamacija;
    string prilogeDialogTitle = string.Empty;
    List<ReklamacijaPrilogaVnosDto> prilogePendingPriloge = new();

    bool showZapisFawDialog;
    int? zapisFawIdReklamacija;
    ReklamacijaFawPreviewDto? zapisFawPreview;
    string? zapisFawError;

    bool showDeleteDialog;
    int? deleteId;
    string deletePartnerNaziv = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    async Task LoadData()
    {
        isLoading = true;
        loadingMessage = "Nalagam reklamacije...";
        await InvokeAsync(StateHasChanged);
        try
        {
            gridData = await ReklamacijeService.GetAllAsync();
            loadingMessage = "Nalagam partnerje...";
            await InvokeAsync(StateHasChanged);
            vsiPartnerji = await ReklamacijeService.GetAllPartnerjeAsync();
            loadingMessage = "Nalagam uporabnike...";
            await InvokeAsync(StateHasChanged);
            uporabniki = (await UporabnikService.GetAllAsync()).Where(u => u.Aktiven).ToList();
            statusi = await ReklamacijeService.GetStatuseAsync();
            loadingMessage = "Nalagam vnose za izbrano reklamacijo...";
            await InvokeAsync(StateHasChanged);
            selectedReklamacija = selectedReklamacija == null
                ? filteredGridData?.FirstOrDefault()
                : gridData.FirstOrDefault(r => r.Id == selectedReklamacija.Id);
            selectedPostavke = selectedReklamacija == null
                ? new()
                : await ReklamacijeService.GetPostavkeAsync(selectedReklamacija.Id);
            loadingMessage = "Pripravljam prikaz...";
            await InvokeAsync(StateHasChanged);
        }
        finally
        {
            isLoading = false;
        }
    }

    async Task OnReklamacijaSelected(GridFocusedRowChangedEventArgs e)
    {
        selectedReklamacija = e.DataItem as ReklamacijaGridDto;
        selectedPostavke = selectedReklamacija == null
            ? new()
            : await ReklamacijeService.GetPostavkeAsync(selectedReklamacija.Id);
    }

    void OnReklamacijaFocused(GridFocusedRowChangedEventArgs e)
    {
        selectedReklamacija = e.DataItem as ReklamacijaGridDto;
    }

    async Task OnReklamacijaRowClick(GridRowClickEventArgs e)
    {
        selectedReklamacija = e.Grid.GetDataItem(e.VisibleIndex) as ReklamacijaGridDto;
        selectedPostavke = selectedReklamacija == null
            ? new()
            : await ReklamacijeService.GetPostavkeAsync(selectedReklamacija.Id);
    }

    void ShowAddDialog(TipReklamacije tip)
    {
        editTipReklamacije = tip;
        dialogTitle = $"Vnos: {TipNaziv(tip)}";
        dialogError = null;
        editingId = null;
        suppressPartnerChanged = true;
        editPartner = 0;
        suppressPartnerChanged = false;
        editKontakt = null;
        editTipPrekinitve = null;
        editRacuniDoDne = null;
        editOpis = null;
        editKomentar = null;
        editKdoNajObdela = null;
        editStatusId = null;
        pendingPriloge.Clear();
        pogodbe.Clear();
        showDialog = true;
    }

    void ToggleSamoMoji()
    {
        filterSamoMoji = !filterSamoMoji;
    }

    void TogglePrikaziResene()
    {
        filterPrikaziResene = !filterPrikaziResene;
    }

    async Task ShowEditDialog(ReklamacijaGridDto item)
    {
        editTipReklamacije = item.TipReklamacije;
        dialogTitle = $"Popravi: {TipNaziv(item.TipReklamacije)}";
        dialogError = null;
        editingId = item.Id;
        suppressPartnerChanged = true;
        editPartner = item.Partner;
        suppressPartnerChanged = false;
        editKontakt = item.Kontakt;
        editTipPrekinitve = item.TipPrekinitve;
        editRacuniDoDne = item.RacuniDoDne;
        editOpis = item.Opis;
        editKomentar = null;
        editKdoNajObdela = null;
        editStatusId = null;
        pendingPriloge.Clear();
        if (editTipReklamacije == TipReklamacije.PrekinitevPogodbe)
            await LoadPogodbe(item.StevilkePogodb);
        else
            pogodbe.Clear();
        showDialog = true;
    }

    async Task OnPartnerChanged(int partner)
    {
        editPartner = partner;
        editKontakt = vsiPartnerji?.FirstOrDefault(p => p.Sifra == partner)?.EPosta;
        if (editTipReklamacije == TipReklamacije.PrekinitevPogodbe)
            await LoadPogodbe(null);
        else
            pogodbe.Clear();
    }

    async Task LoadPogodbe(string? selectedStevilke)
    {
        pogodbe.Clear();
        if (editPartner == 0)
            return;

        loadingPogodbe = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            pogodbe = await ReklamacijeService.GetVeljavnePogodbeAsync(editPartner);
            if (!string.IsNullOrWhiteSpace(selectedStevilke))
            {
                var selected = selectedStevilke.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToHashSet(StringComparer.OrdinalIgnoreCase);
                foreach (var pogodba in pogodbe)
                    pogodba.Prekini = selected.Contains(pogodba.DisplayStevilka);
            }
        }
        catch (Exception ex)
        {
            dialogError = ex.Message;
        }
        finally
        {
            loadingPogodbe = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    void ShowDeleteConfirm(ReklamacijaGridDto item)
    {
        deleteId = item.Id;
        deletePartnerNaziv = item.PartnerDisplay;
        showDeleteDialog = true;
    }

    void ShowPostavkaDialog(ReklamacijaGridDto item)
    {
        postavkaIdReklamacija = item.Id;
        postavkaKomentar = null;
        postavkaKdoNajObdela = null;
        postavkaStatusId = null;
        postavkaDialogError = null;
        postavkaPendingPriloge.Clear();
        showPostavkaDialog = true;
    }

    void ShowPostavkaForSelected()
    {
        if (selectedReklamacija != null)
            ShowPostavkaDialog(selectedReklamacija);
    }

    async Task ShowStatusiDialog()
    {
        statusiError = null;
        statusi = await ReklamacijeService.GetStatuseAsync();
        CancelStatusEdit();
        showStatusiDialog = true;
    }

    void OnStatusRowClick(GridRowClickEventArgs e)
    {
        if (e.Grid.GetDataItem(e.VisibleIndex) is not ReklamacijaStatusSifrantDto status) return;

        statusId = status.Id;
        statusNaziv = status.Naziv;
        statusBarva = status.Barva;
        statusiError = null;
        statusEditVisible = true;
    }

    void NewStatus()
    {
        statusId = null;
        statusNaziv = string.Empty;
        statusBarva = "#F5F5F5";
        statusiError = null;
        statusEditVisible = true;
    }

    void CancelStatusEdit()
    {
        statusId = null;
        statusNaziv = string.Empty;
        statusBarva = "#F5F5F5";
        statusiError = null;
        statusEditVisible = false;
    }

    async Task SaveStatus()
    {
        if (string.IsNullOrWhiteSpace(statusNaziv))
        {
            statusiError = "Vnesite naziv.";
            return;
        }

        var status = new ReklamacijaStatusSifrantDto
        {
            Id = statusId ?? 0,
            Naziv = statusNaziv,
            Barva = statusBarva
        };

        try
        {
            if (statusId.HasValue)
                await ReklamacijeService.UpdateStatusAsync(status);
            else
                status.Id = await ReklamacijeService.AddStatusAsync(status);

            statusi = await ReklamacijeService.GetStatuseAsync();
            statusId = status.Id;
            statusiError = null;
            statusEditVisible = false;
        }
        catch (Exception ex)
        {
            statusiError = ex.Message;
        }
    }

    async Task DeleteStatus()
    {
        if (!statusId.HasValue) return;

        try
        {
            await ReklamacijeService.DeleteStatusAsync(statusId.Value);
            statusi = await ReklamacijeService.GetStatuseAsync();
            CancelStatusEdit();
        }
        catch (Exception ex)
        {
            statusiError = ex.Message;
        }
    }

    void CustomizeStatusGridElement(GridCustomizeElementEventArgs e)
    {
        if (e.ElementType != GridElementType.DataRow) return;
        if (e.Grid.GetDataItem(e.VisibleIndex) is ReklamacijaStatusSifrantDto status && !string.IsNullOrWhiteSpace(status.Barva))
            e.Style = $"background-color:{status.Barva};";
    }

    void CustomizeReklamacijeGridElement(GridCustomizeElementEventArgs e)
    {
        if (e.ElementType != GridElementType.DataRow) return;
        if (e.Grid.GetDataItem(e.VisibleIndex) is ReklamacijaGridDto item
            && string.IsNullOrWhiteSpace(item.KdoNajObdela)
            && !string.IsNullOrWhiteSpace(item.ZadnjiStatusBarva))
            e.Style = $"background-color:{item.ZadnjiStatusBarva};";
    }

    void ShowPrilogeDialog(ReklamacijaGridDto item)
    {
        prilogeIdReklamacija = item.Id;
        prilogeDialogTitle = $"Priponke - {item.PartnerDisplay}";
        prilogePendingPriloge.Clear();
        showPrilogeDialog = true;
    }

    async Task ShowZapisFawDialog(ReklamacijaGridDto item)
    {
        zapisFawIdReklamacija = item.Id;
        zapisFawPreview = null;
        zapisFawError = null;
        showZapisFawDialog = true;

        try
        {
            zapisFawPreview = await ReklamacijeService.GetFawPreviewAsync(item.Id);
        }
        catch (Exception ex)
        {
            zapisFawError = ex.Message;
        }
    }

    async Task PotrdiZapisFaw()
    {
        if (!zapisFawIdReklamacija.HasValue)
            return;

        zapisFawError = null;
        try
        {
            await ReklamacijeService.ZapisVFawAsync(zapisFawIdReklamacija.Value);
            showZapisFawDialog = false;
        }
        catch (Exception ex)
        {
            zapisFawError = ex.Message;
        }
    }

    async Task SaveData()
    {
        if (editPartner == 0)
        {
            dialogError = "Izberite partnerja.";
            return;
        }
        if (editTipReklamacije == TipReklamacije.PrekinitevPogodbe && !pogodbe.Any(p => p.Prekini))
        {
            dialogError = "Izberite vsaj eno pogodbo za prekinitev.";
            return;
        }

        if (string.IsNullOrWhiteSpace(editKdoNajObdela) && editStatusId == null)
        {
            dialogError = "Izberite status.";
            return;
        }

        dialogError = null;
        var form = new ReklamacijaFormDto
        {
            TipReklamacije = editTipReklamacije,
            Partner = editPartner,
            Kontakt = editKontakt,
            TipPrekinitve = editTipReklamacije == TipReklamacije.PrekinitevPogodbe ? editTipPrekinitve : null,
            RacuniDoDne = editTipReklamacije == TipReklamacije.PrekinitevPogodbe ? editRacuniDoDne : null,
            Opis = editTipReklamacije == TipReklamacije.Reklamacija ? editOpis : null,
            Komentar = editKomentar,
            KdoNajObdela = editKdoNajObdela,
            StatusId = editStatusId,
            Pogodbe = editTipReklamacije == TipReklamacije.PrekinitevPogodbe ? pogodbe : new()
        };

        try
        {
            if (editingId.HasValue)
            {
                await ReklamacijeService.UpdateAsync(editingId.Value, form);
            }
            else
            {
                var newId = await ReklamacijeService.AddAsync(form);
                if (pendingPriloge.Count > 0)
                    await ReklamacijeService.AddPrilogeAsync(newId, pendingPriloge);
                pendingPriloge.Clear();
            }

            showDialog = false;
            await LoadData();
        }
        catch (Exception ex)
        {
            dialogError = ex.Message;
        }
    }

    async Task DeleteData()
    {
        if (!deleteId.HasValue)
            return;

        try
        {
            await ReklamacijeService.DeleteAsync(deleteId.Value);
            showDeleteDialog = false;
            await LoadData();
        }
        catch (Exception ex)
        {
            dialogError = ex.Message;
        }
    }

    async Task SavePostavka()
    {
        if (!postavkaIdReklamacija.HasValue)
            return;

        if (string.IsNullOrWhiteSpace(postavkaKomentar))
        {
            postavkaDialogError = "Vnesite komentar.";
            return;
        }

        if (string.IsNullOrWhiteSpace(postavkaKdoNajObdela) && postavkaStatusId == null)
        {
            postavkaDialogError = "Izberite status.";
            return;
        }

        postavkaDialogError = null;
        try
        {
            await ReklamacijeService.AddPostavkaAsync(postavkaIdReklamacija.Value, postavkaKomentar, postavkaKdoNajObdela, postavkaStatusId);
            var updated = await ReklamacijeService.GetByIdAsync(postavkaIdReklamacija.Value);
            if (updated != null && gridData != null)
            {
                var index = gridData.FindIndex(r => r.Id == updated.Id);
                if (index >= 0)
                    gridData[index] = updated;
            }

            showPostavkaDialog = false;
        }
        catch (Exception ex)
        {
            postavkaDialogError = ex.Message;
        }
    }
}
