@* ZAČASNA STRAN — za brisanje: odstrani datoteko Components\Pages\KontrolaPredracunov.razor *@
@page "/kontrola-predracunov"
@rendermode InteractiveServer
@using ObracunDb.Data.DTOs
@using FirebirdSql.Data.FirebirdClient
@inject ObracunDb.Data.FirebirdConnectionManager ConnectionManager
@inject ObracunDb.Services.ObracunService ObracunService
@inject ObracunDb.Services.AuthService AuthService

<PageTitle>Kontrola predračunov</PageTitle>

@if (AuthService.CurrentUser?.Vloga != 0)
{
    <div class="alert alert-danger">Dostop samo za administratorje.</div>
}
else
{
    <div style="display: flex; flex-direction: column; height: calc(100vh - 4rem); gap: 4px;">

        <div style="display: flex; align-items: center; gap: 8px; flex-shrink: 0;">
            <h5 style="margin: 0;">Kontrola predračunov</h5>
            <DxButton Text="Kontrola" RenderStyle="ButtonRenderStyle.Primary" Click="@OnKontrola" />
            @if (isLoading)
            {
                <span class="text-muted">Nalagam...</span>
            }
        </div>

        @if (partnerji.Count > 0)
        {
            <!-- Zgornji del: levo partnerji, desno koriščeni predračuni -->
            <div style="flex: 1; display: flex; gap: 8px; min-height: 0;">
                <!-- Zgoraj levo: partnerji -->
                <div style="flex: 1; overflow: hidden; display: flex; flex-direction: column;">
                    <span style="margin:0; padding:0; line-height:1; height:16px;">Partnerji</span>
                    <div style="flex: 1; overflow: hidden;">
                        <DxGrid Data="@partnerji"
                                KeyFieldName="@nameof(KontrolaPartnerDto.Partner)"
                                ShowFilterRow="true"
                                FocusedRowEnabled="true"
                                FocusedRowChanged="@OnPartnerSelected"
                                CssClass="w-100"
                                PageSize="0"
                                VirtualScrollingEnabled="true"
                                style="height: 100%">
                            <Columns>
                                <DxGridDataColumn FieldName="@nameof(KontrolaPartnerDto.Partner)" Caption="Šifra" Width="80px" />
                                <DxGridDataColumn FieldName="@nameof(KontrolaPartnerDto.NazivPartnerja)" Caption="Partner" />
                                <DxGridDataColumn FieldName="@nameof(KontrolaPartnerDto.StPojavitev)" Caption="Št. zapisov" Width="100px" />
                                <DxGridDataColumn FieldName="@nameof(KontrolaPartnerDto.Pred31Okt)" Caption="Pred31.10" Width="75px" />
                                <DxGridDataColumn FieldName="@nameof(KontrolaPartnerDto.ObstajaPo31Okt)" Caption="Obstajapo31.10" Width="100px" />
                            </Columns>
                        </DxGrid>
                    </div>
                </div>

                <!-- Zgoraj desno: koriščeni predračuni (poraba minut) -->
                <div style="flex: 1; overflow: hidden; display: flex; flex-direction: column;">
                    <span style="margin:0; padding:0; line-height:1; height:16px;">Koriščenje predračunov (mesec=1, leto=2026)</span>
                    <div style="flex: 1; overflow: hidden;">
                        <DxGrid Data="@porabaDetail"
                                KeyFieldName="@nameof(KontrolaPorabaDto.Key)"
                                FocusedRowEnabled="true"
                                FocusedRowChanged="@OnPorabaSelected"
                                CssClass="w-100"
                                PageSize="0"
                                VirtualScrollingEnabled="true"
                                style="height: 100%">
                            <Columns>
                                <DxGridDataColumn FieldName="@nameof(KontrolaPorabaDto.PredracunStevilka)" Caption="Predračun št." Width="110px" />
                                <DxGridDataColumn FieldName="@nameof(KontrolaPorabaDto.PredracunLeto)" Caption="Leto" Width="60px" />
                                <DxGridDataColumn FieldName="@nameof(KontrolaPorabaDto.PredracunDatum)" Caption="Datum" DisplayFormat="dd.MM.yyyy" Width="95px" />
                                <DxGridDataColumn FieldName="@nameof(KontrolaPorabaDto.Kolicina)" Caption="Koriščene min" Width="110px" />
                            </Columns>
                            <TotalSummary>
                                <DxGridSummaryItem SummaryType="GridSummaryItemType.Sum" FieldName="@nameof(KontrolaPorabaDto.Kolicina)" DisplayText="Skupaj: {0}" />
                            </TotalSummary>
                        </DxGrid>
                    </div>
                </div>
            </div>

            <hr style="margin: 0;" />

            <!-- Spodnji del: levo predračuni partnerja, desno postavke predračuna -->
            <div style="flex: 1; display: flex; gap: 8px; min-height: 0;">
                <!-- Spodaj levo: predračuni partnerja (potrjeni/plačani) -->
                <div style="flex: 1; overflow: hidden; display: flex; flex-direction: column;">
                    <span style="margin:0; padding:0; line-height:1; height:16px;">Predračuni partnerja (potrjeni / plačani)</span>
                    <div style="flex: 1; overflow: hidden;">
                        <DxGrid Data="@predracuni"
                                KeyFieldName="@nameof(PredracunGridDto.Key)"
                                FocusedRowEnabled="true"
                                FocusedRowChanged="@OnPredracunSelected"
                                CssClass="w-100"
                                PageSize="0"
                                VirtualScrollingEnabled="true"
                                style="height: 100%">
                            <Columns>
                                <DxGridDataColumn FieldName="@nameof(PredracunGridDto.Stevilka)" Caption="Številka" Width="90px" />
                                <DxGridDataColumn FieldName="@nameof(PredracunGridDto.Leto)" Caption="Leto" Width="55px" />
                                <DxGridDataColumn FieldName="@nameof(PredracunGridDto.Datum)" Caption="Datum" DisplayFormat="dd.MM.yyyy" Width="95px" />
                                <DxGridDataColumn FieldName="@nameof(PredracunGridDto.ZnesekBrezDdv)" Caption="Znesek" DisplayFormat="N2" Width="95px" />
                                <DxGridDataColumn FieldName="@nameof(PredracunGridDto.Minute)" Caption="Min" Width="55px" />
                                <DxGridDataColumn FieldName="@nameof(PredracunGridDto.MinutePreostalo)" Caption="Preost." Width="65px" />
                                <DxGridDataColumn FieldName="@nameof(PredracunGridDto.StanjePrikaz)" Caption="Status" Width="80px" />
                            </Columns>
                        </DxGrid>
                    </div>
                </div>

                <!-- Spodaj desno: postavke predračuna -->
                <div style="flex: 1; overflow: hidden; display: flex; flex-direction: column;">
                    <span style="margin:0; padding:0; line-height:1; height:16px;">Postavke predračuna @postavkeNaslov</span>
                    <div style="flex: 1; overflow: hidden;">
                        <DxGrid Data="@postavkePostavke"
                                KeyFieldName="@nameof(PredracunKnjizbaGridDto.Zs)"
                                CssClass="w-100"
                                PageSize="0"
                                VirtualScrollingEnabled="true"
                                style="height: 100%">
                            <Columns>
                                <DxGridDataColumn FieldName="@nameof(PredracunKnjizbaGridDto.SifraArtikla)" Caption="Šifra" Width="90px" />
                                <DxGridDataColumn FieldName="@nameof(PredracunKnjizbaGridDto.NazivArtikla)" Caption="Naziv" />
                                <DxGridDataColumn FieldName="@nameof(PredracunKnjizbaGridDto.Kolicina)" Caption="Količina" DisplayFormat="N2" Width="85px" />
                                <DxGridDataColumn FieldName="@nameof(PredracunKnjizbaGridDto.ProdajnaCena)" Caption="Cena" DisplayFormat="N2" Width="85px" />
                                <DxGridDataColumn FieldName="@nameof(PredracunKnjizbaGridDto.ProdajnaVrednost)" Caption="Vrednost" DisplayFormat="N2" Width="95px" />
                                <DxGridDataColumn FieldName="@nameof(PredracunKnjizbaGridDto.Minute)" Caption="Minute" Width="70px" />
                            </Columns>
                        </DxGrid>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    bool isLoading;
    List<KontrolaPartnerDto> partnerji = new();
    List<KontrolaPorabaDto> porabaDetail = new();
    List<PredracunGridDto> predracuni = new();
    List<PredracunKnjizbaGridDto> postavkePostavke = new();
    string postavkeNaslov = "";

    // Surovi podatki za filtriranje po partnerju
    List<KontrolaPorabaDto> vsiZapisi = new();

    // Cache datumov predračunov za prikaz v levem gridu
    Dictionary<string, DateTime?> predracunDatumi = new();

    async Task OnKontrola()
    {
        isLoading = true;
        partnerji.Clear();
        porabaDetail.Clear();
        predracuni.Clear();
        postavkePostavke.Clear();
        vsiZapisi.Clear();
        predracunDatumi.Clear();

        try
        {
            await using var connection = ConnectionManager.GetConnection();
            await connection.OpenAsync();

            // Preberi datume predračunov
            await using (var cmdDat = new FbCommand("SELECT STEVILKA, LETO, DATUM FROM FA_PREDRACUN WHERE LETO >= 2024", connection))
            {
                await using var rdr = await cmdDat.ExecuteReaderAsync();
                while (await rdr.ReadAsync())
                {
                    var st = rdr.GetString(0).Trim();
                    var l = rdr.GetInt32(1);
                    var dat = rdr.IsDBNull(2) ? (DateTime?)null : rdr.GetDateTime(2);
                    predracunDatumi[$"{st}_{l}"] = dat;
                }
            }

            // Preberi porabo minut za mesec=1, leto=2026, samo TIP=1 (predračuni)
            await using var cmd = new FbCommand(@"
                SELECT pm.PARTNER, p.NAZIV, pm.PREDRACUN_STEVILKA, pm.PREDRACUN_LETO, pm.KOLICINA
                FROM OBRACUN_PORABA_MINUT pm
                LEFT JOIN PARTNER p ON pm.PARTNER = p.SIFRA
                WHERE pm.MESEC = 1 AND pm.LETO = 2026 AND pm.TIP = 1
                ORDER BY p.NAZIV, pm.PARTNER, pm.PREDRACUN_STEVILKA", connection);

            await using var reader = await cmd.ExecuteReaderAsync();
            while (await reader.ReadAsync())
            {
                var partner = reader.GetInt32(0);
                var naziv = reader.IsDBNull(1) ? null : reader.GetString(1).Trim();
                var predSt = reader.IsDBNull(2) ? 0 : reader.GetInt32(2);
                var predLeto = reader.IsDBNull(3) ? 0 : reader.GetInt32(3);
                var kolicina = reader.IsDBNull(4) ? 0 : reader.GetInt32(4);

                var predStStr = predSt.ToString();
                predracunDatumi.TryGetValue($"{predStStr}_{predLeto}", out var datum);
                if (datum == null)
                    predracunDatumi.TryGetValue($"{predSt.ToString().PadLeft(7, '0')}_{predLeto}", out datum);

                vsiZapisi.Add(new KontrolaPorabaDto
                {
                    Partner = partner,
                    NazivPartnerja = naziv,
                    PredracunStevilka = predStStr,
                    PredracunLeto = predLeto,
                    Kolicina = kolicina,
                    PredracunDatum = datum
                });
            }

            // Preberi partnerje, ki imajo predračune z datumom >= 31.10.2025, statusom 5 ali plačani, in minutami
            var partnerjePo31Okt = new HashSet<int>();
            await using (var cmdPo = new FbCommand(@"
                SELECT DISTINCT fp.SIFRA_KUPCA
                FROM FA_PREDRACUN fp
                WHERE fp.DATUM >= '2025-10-31'
                  AND fp.LETO >= 2025
                  AND (
                   fp.STANJE IN (2, 5)
                    OR EXISTS (
                      SELECT 1 FROM FA_RACUN_PLACILO rp
                      WHERE rp.PREDRACUN_STEVILKA = fp.STEVILKA AND rp.PREDRACUN_LETO = fp.LETO
                        AND (rp.ZNESEK + COALESCE(rp.SCONTO, 0)) > 0
                    )
                  )
                  AND EXISTS (
                    SELECT 1 FROM FA_PREDRACUN_KNJIZBA k
                    JOIN OBRACUN_PAKET_MINUTE pm ON TRIM(k.SIFRA) = TRIM(pm.ARTIKEL)
                    WHERE k.STEVILKA = fp.STEVILKA AND k.LETO = fp.LETO
                  )", connection))
            {
                await using var rdrPo = await cmdPo.ExecuteReaderAsync();
                while (await rdrPo.ReadAsync())
                    partnerjePo31Okt.Add(rdrPo.GetInt32(0));
            }

            // Združi po partnerju
            partnerji = vsiZapisi
                .GroupBy(z => z.Partner)
                .Select(g => new KontrolaPartnerDto
                {
                    Partner = g.Key,
                    NazivPartnerja = g.First().NazivPartnerja,
                    StPojavitev = g.Count(),
                    Pred31Okt = g.Any(z => z.PredracunDatum.HasValue && z.PredracunDatum.Value < new DateTime(2025, 10, 31)) ? "DA" : "",
                    ObstajaPo31Okt = partnerjePo31Okt.Contains(g.Key) ? "DA" : ""
                })
                .OrderBy(p => p.NazivPartnerja)
                .ThenBy(p => p.Partner)
                .ToList();
        }
        catch (Exception ex)
        {
            partnerji.Clear();
            vsiZapisi.Clear();
        }
        finally
        {
            isLoading = false;
        }
    }

    async Task OnPartnerSelected(GridFocusedRowChangedEventArgs e)
    {
        if (e.DataItem is KontrolaPartnerDto row)
        {
            postavkePostavke.Clear();
            postavkeNaslov = "";

            porabaDetail = vsiZapisi
                .Where(z => z.Partner == row.Partner)
                .ToList();

            try
            {
                var vsi = await ObracunService.GetPredracuniZaPartnerjaAsync(row.Partner, 1, 2026);
                predracuni = vsi
                    .Where(p => p.StanjePrikaz is "Potrjen" or "Plačano" or "Delno")
                    .ToList();
            }
            catch
            {
                predracuni = new();
            }
        }
    }

    async Task OnPorabaSelected(GridFocusedRowChangedEventArgs e)
    {
        if (e.DataItem is KontrolaPorabaDto row && !string.IsNullOrEmpty(row.PredracunStevilka) && row.PredracunLeto > 0)
        {
            try
            {
                var stevilka = row.PredracunStevilka.PadLeft(7, '0');
                postavkePostavke = await ObracunService.GetPostavkePredracunaAsync(stevilka, row.PredracunLeto);
                if (postavkePostavke.Count == 0)
                    postavkePostavke = await ObracunService.GetPostavkePredracunaAsync(row.PredracunStevilka, row.PredracunLeto);
                postavkeNaslov = $"({stevilka}/{row.PredracunLeto})";
            }
            catch
            {
                postavkePostavke = new();
            }
        }
    }

    async Task OnPredracunSelected(GridFocusedRowChangedEventArgs e)
    {
        if (e.DataItem is PredracunGridDto row)
        {
            try
            {
                postavkePostavke = await ObracunService.GetPostavkePredracunaAsync(row.Stevilka, row.Leto);
                postavkeNaslov = $"({row.Stevilka}/{row.Leto})";
            }
            catch
            {
                postavkePostavke = new();
            }
        }
    }

    // --- Začasni DTO-ji (za brisanje skupaj s to stranjo) ---

    class KontrolaPartnerDto
    {
        public int Partner { get; set; }
        public string? NazivPartnerja { get; set; }
        public int StPojavitev { get; set; }
        public string Pred31Okt { get; set; } = "";
        public string ObstajaPo31Okt { get; set; } = "";
    }

    class KontrolaPorabaDto
    {
        public int Partner { get; set; }
        public string? NazivPartnerja { get; set; }
        public string PredracunStevilka { get; set; } = "";
        public int PredracunLeto { get; set; }
        public int Kolicina { get; set; }
        public DateTime? PredracunDatum { get; set; }
        public string Pred31Okt => PredracunDatum.HasValue && PredracunDatum.Value < new DateTime(2025, 10, 31) ? "DA" : "";
        public string Key => $"{Partner}_{PredracunStevilka}_{PredracunLeto}";
    }
}
