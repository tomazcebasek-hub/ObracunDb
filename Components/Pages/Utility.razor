@page "/utility"
@rendermode InteractiveServer

@using ClosedXML.Excel
@using FirebirdSql.Data.FirebirdClient
@inject ObracunDb.Data.FirebirdConnectionManager ConnectionManager
@inject ObracunDb.Services.AuthService AuthService
@inject NavigationManager NavigationManager

@if (AuthService.CurrentUser?.Vloga != 0)
{
    <div class="alert alert-danger">Dostop samo za administratorje.</div>
}
else
{
<h5>Utility</h5>

<div class="mb-3">
    <DxButton Text="Kontrola predračunov" RenderStyle="ButtonRenderStyle.Info" Click="@(() => NavigationManager.NavigateTo("/kontrola-predracunov"))" />
</div>

<hr />

<div class="mb-3">
    <label class="form-label"><strong>Uvoz nalogov iz XLSX (stolpec H = številka-leto, E = ure, F = minute):</strong></label>
    <InputFile OnChange="@OnFileSelected" accept=".xls,.xlsx" class="form-control" style="max-width: 400px;" />
</div>

<div class="mb-3">
    <button class="btn btn-primary" @onclick="OnUvozi" disabled="@(selectedFile == null || isProcessing)">Uvozi</button>
</div>

@if (isProcessing)
{
    <p class="text-muted">Obdelujem...</p>
}
else if (rezultat != null)
{
    <div class="alert alert-success" style="max-width: 600px;">
        <pre style="white-space: pre-wrap; margin: 0;">@rezultat</pre>
    </div>
}
else if (napaka != null)
{
    <div class="alert alert-danger" style="max-width: 600px;">@napaka</div>
}
}

@code {
    bool isProcessing;
    string? rezultat;
    string? napaka;
    IBrowserFile? selectedFile;

    void OnFileSelected(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
        rezultat = null;
        napaka = null;
    }

    async Task OnUvozi()
    {
        if (selectedFile == null)
            return;

        rezultat = null;
        napaka = null;
        isProcessing = true;

        try
        {
            using var stream = new MemoryStream();
            await selectedFile.OpenReadStream(maxAllowedSize: 50 * 1024 * 1024).CopyToAsync(stream);
            stream.Position = 0;

            using var workbook = new XLWorkbook(stream);
            var sheet = workbook.Worksheets.FirstOrDefault(ws => ws.Name == "List1");
            if (sheet == null)
            {
                napaka = "List z imenom 'List1' ni bil najden v datoteki.";
                return;
            }

            // Preberemo vrstice: H = številka naloga (format "stevilka-leto"), E = ure, F = minute
            var vnosi = new List<(string Stevilka, int Leto, int Minute)>();
            var lastRow = sheet.LastRowUsed()?.RowNumber() ?? 0;
            int preskocenih = 0;

            for (int row = 1; row <= lastRow; row++)
            {
                var cellH = sheet.Cell(row, 8).GetString().Trim(); // H
                if (string.IsNullOrEmpty(cellH) || !cellH.Contains('-'))
                    continue;

                var parts = cellH.Split('-');
                if (parts.Length < 2 || !int.TryParse(parts[1], out var leto))
                {
                    preskocenih++;
                    continue;
                }

                var stevilka = parts[0].Trim();
                if (string.IsNullOrEmpty(stevilka))
                {
                    preskocenih++;
                    continue;
                }

                // Uvozi samo vrstice z letom 2025
                if (leto != 2025)
                {
                    preskocenih++;
                    continue;
                }

                var ure = 0;
                var min = 0;
                var cellE = sheet.Cell(row, 5); // E = ure
                var cellF = sheet.Cell(row, 6); // F = minute

                if (cellE.DataType == XLDataType.Number)
                    ure = (int)cellE.GetDouble();
                else if (int.TryParse(cellE.GetString().Trim(), out var u))
                    ure = u;

                if (cellF.DataType == XLDataType.Number)
                    min = (int)cellF.GetDouble();
                else if (int.TryParse(cellF.GetString().Trim(), out var m))
                    min = m;

                var skupajMinut = ure * 60 + min;
                vnosi.Add((stevilka, leto, skupajMinut));
            }

            if (vnosi.Count == 0)
            {
                napaka = $"Nobena veljavna vrstica ni bila najdena v listu List1. Preskočenih: {preskocenih}";
                return;
            }

            // Brezpogojno pobriši OBRACUN_DN za leto 2025, nato vstavi
            await using var connection = ConnectionManager.GetConnection();
            await connection.OpenAsync();
            await using var transaction = await connection.BeginTransactionAsync();

            try
            {
                // DELETE
                await using (var cmd = new FbCommand("DELETE FROM OBRACUN_DN WHERE LETO = 2025", connection))
                {
                    cmd.Transaction = transaction;
                    var deleted = await cmd.ExecuteNonQueryAsync();
                }

                // INSERT
                int inserted = 0;
                foreach (var (stevilka, leto, minute) in vnosi)
                {
                    await using var cmd = new FbCommand(
                        "INSERT INTO OBRACUN_DN (STEVILKA, LETO, KAJ_OBRACUNAM, MINUTE_NALOGA) VALUES (@Stevilka, @Leto, @Kaj, @Minute)",
                        connection);
                    cmd.Transaction = transaction;
                    cmd.Parameters.AddWithValue("@Stevilka", stevilka);
                    cmd.Parameters.AddWithValue("@Leto", leto);
                    cmd.Parameters.AddWithValue("@Kaj", (int)ObracunDb.Data.Entities.KajObracunam.Min);
                    cmd.Parameters.AddWithValue("@Minute", minute);
                    await cmd.ExecuteNonQueryAsync();
                    inserted++;
                }

                await transaction.CommitAsync();

                rezultat = $"Uspešno!\nPrebrano vrstic: {vnosi.Count}\nVstavljenih zapisov v OBRACUN_DN: {inserted}\nPreskočenih vrstic: {preskocenih}";
            }
            catch
            {
                await transaction.RollbackAsync();
                throw;
            }
        }
        catch (Exception ex)
        {
            napaka = $"Napaka: {ex.Message}";
        }
        finally
        {
            isProcessing = false;
        }
    }
}
