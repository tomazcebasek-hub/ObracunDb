@page "/predracuni"
@using ObracunDb.Data.DTOs
@using ObracunDb.Services
@inject PredracunService PredracunService
@inject NavigationManager Navigation

<PageTitle>Predraèuni</PageTitle>

<div style="display:flex; flex-direction:column; flex:1; min-height:0;">
    <div style="display:flex; flex-direction:row; flex-wrap:nowrap; align-items:center; gap:8px; margin-bottom:8px; flex-shrink:0;">
        <span>Obdobje:</span>
        <div style="width:120px; flex:0 0 auto;">
            <DxComboBox Data="@obdobjaTipi"
                        Value="@izbranTipObdobja"
                        ValueChanged="@((string v) => OnTipObdobjaChanged(v))" />
        </div>
        @if (izbranTipObdobja == "Mesec")
        {
            <div style="width:120px; flex:0 0 auto;">
                <DxComboBox Data="@meseci"
                            Value="@izbranMesec"
                            ValueChanged="@((MesecOpt v) => OnMesecChanged(v))"
                            TextFieldName="@nameof(MesecOpt.Naziv)" />
            </div>
        }
        else if (izbranTipObdobja == "Èetrtletje")
        {
            <div style="width:120px; flex:0 0 auto;">
                <DxComboBox Data="@cetrtletja"
                            Value="@izbranoCetrtletje"
                            ValueChanged="@((CetrtletjeOpt v) => OnCetrtletjeChanged(v))"
                            TextFieldName="@nameof(CetrtletjeOpt.Naziv)" />
            </div>
        }
        else if (izbranTipObdobja == "Leto")
        {
            <div style="width:100px; flex:0 0 auto;">
                <DxComboBox Data="@leta"
                            Value="@izbranoLeto"
                            ValueChanged="@((int? v) => OnLetoChanged(v))"
                            TData="int" TValue="int?" />
            </div>
        }
        <DxButton Text="Naloži" Click="@LoadData" RenderStyle="ButtonRenderStyle.Primary" />
        <DxButton Text="Vsa obdobja" Click="@ClearObdobje" RenderStyle="ButtonRenderStyle.Secondary" />
    </div>

    @if (isLoading)
    {
        <p>Nalagam podatke...</p>
    }
    else if (predracuni == null)
    {
        <p class="text-muted">Izberite obdobje in kliknite <b>Naloži</b>.</p>
    }
    else
    {
    <div style="flex:1; min-height:0;">
    <DxGrid @ref="grid"
            Data="@filteredPredracuni"
            KeyFieldName="@nameof(PredracunGridDto.Key)"
            ShowFilterRow="true"
            ShowFooter="true"
            PageSize="int.MaxValue"
            PagerVisible="false"
            CssClass="w-100 h-100">
        <Columns>
            <DxGridDataColumn FieldName="@nameof(PredracunGridDto.Stevilka)" Caption="Številka" Width="100px" />
            <DxGridDataColumn FieldName="@nameof(PredracunGridDto.Leto)" Caption="Leto" Width="80px" />
            <DxGridDataColumn FieldName="@nameof(PredracunGridDto.Datum)" Caption="Datum" DisplayFormat="dd.MM.yyyy" Width="120px" />
            <DxGridDataColumn FieldName="@nameof(PredracunGridDto.SifraKupca)" Caption="Šifra" Width="100px" />
            <DxGridDataColumn FieldName="@nameof(PredracunGridDto.NazivPartnerja)" Caption="Naziv partnerja" />
            <DxGridDataColumn FieldName="@nameof(PredracunGridDto.NazivKomercialista)" Caption="Komercialist" Width="160px">
                <FilterRowCellTemplate Context="frc">
                    <DxComboBox Data="@komercialistiLookup"
                                Value="@(frc.FilterRowValue as string)"
                                ValueChanged="@((string v) => frc.FilterRowValue = v)"
                                NullText="(vsi)"
                                FilteringMode="DataGridFilteringMode.Contains"
                                ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                CssClass="w-100" />
                </FilterRowCellTemplate>
            </DxGridDataColumn>
            <DxGridDataColumn FieldName="@nameof(PredracunGridDto.ZnesekKoncni)" Caption="Znesek" DisplayFormat="N2" Width="120px" />
            <DxGridDataColumn FieldName="@nameof(PredracunGridDto.Placano)" Caption="Plaèano" DisplayFormat="N2" Width="120px" />
            <DxGridDataColumn FieldName="@nameof(PredracunGridDto.PlacanoIzRacunov)" Caption="PlaèRaè" DisplayFormat="N2" Width="120px" />
            <DxGridDataColumn FieldName="@nameof(PredracunGridDto.RacunStatus)" Caption="Raèun" Width="150px" />
            <DxGridDataColumn FieldName="@nameof(PredracunGridDto.PovezaniRacuni)" Caption="Št. raèuna" Width="120px" />
            <DxGridDataColumn FieldName="@nameof(PredracunGridDto.StanjePrikaz)" Caption="Stanje" Width="160px">
                <FilterRowCellTemplate>
                    <div style="position:relative;">
                        <button type="button" class="btn btn-light btn-sm w-100 text-start"
                                @onclick="@(() => stanjeDropdownOpen = !stanjeDropdownOpen)">
                            @StanjeFilterCaption()
                        </button>
                        @if (stanjeDropdownOpen)
                        {
                            <div style="position:absolute; top:100%; left:0; z-index:1050; background:white; border:1px solid #ccc; padding:8px; min-width:180px; max-height:260px; overflow:auto; box-shadow:0 2px 6px rgba(0,0,0,0.15);">
                                @foreach (var s in stanjeLookup)
                                {
                                    var label = string.IsNullOrEmpty(s) ? "(prazno)" : s;
                                    <div style="padding:2px 0;">
                                        <DxCheckBox Checked="@filterStanje.Contains(s)"
                                                    CheckedChanged="@((bool v) => OnStanjeFilterChanged(s, v))">
                                            @label
                                        </DxCheckBox>
                                    </div>
                                }
                                <div style="margin-top:6px; display:flex; gap:4px;">
                                    <DxButton Text="Poèisti" RenderStyle="ButtonRenderStyle.Secondary" Click="@ClearStanjeFilter" />
                                    <DxButton Text="Zapri" RenderStyle="ButtonRenderStyle.Light" Click="@(() => stanjeDropdownOpen = false)" />
                                </div>
                            </div>
                        }
                    </div>
                </FilterRowCellTemplate>
            </DxGridDataColumn>
        </Columns>
        <TotalSummary>
            <DxGridSummaryItem SummaryType="GridSummaryItemType.Sum" FieldName="@nameof(PredracunGridDto.ZnesekKoncni)" DisplayFormat="N2" DisplayText="{0:N2}" FooterColumnName="@nameof(PredracunGridDto.ZnesekKoncni)" />
            <DxGridSummaryItem SummaryType="GridSummaryItemType.Sum" FieldName="@nameof(PredracunGridDto.Placano)" DisplayFormat="N2" DisplayText="{0:N2}" FooterColumnName="@nameof(PredracunGridDto.Placano)" />
            <DxGridSummaryItem SummaryType="GridSummaryItemType.Sum" FieldName="@nameof(PredracunGridDto.PlacanoIzRacunov)" DisplayFormat="N2" DisplayText="{0:N2}" FooterColumnName="@nameof(PredracunGridDto.PlacanoIzRacunov)" />
        </TotalSummary>
        <DetailRowTemplate Context="dataItem">
            @{
                var predracun = (PredracunGridDto)dataItem.DataItem;
            }
            <DetailGridComponent Stevilka="@predracun.Stevilka" Leto="@predracun.Leto" />
        </DetailRowTemplate>
    </DxGrid>
    </div>

    <div class="d-flex gap-2 align-items-center" style="flex-shrink:0; padding:8px 0;">
        <DxButton Text="Potrjen in ni raèuna" 
                  Click="@ApplyQuickFilter" 
                  RenderStyle="ButtonRenderStyle.Primary" />
        <DxButton Text="X" 
                  Click="@ClearFilters" 
                  RenderStyle="ButtonRenderStyle.Secondary" />
        <DxButton Text="Statistika" 
                  Click="@(() => Navigation.NavigateTo("/statistika"))" 
                  RenderStyle="ButtonRenderStyle.Info" />
    </div>
    }
    </div>

@code {
    IGrid? grid;
    List<PredracunGridDto>? predracuni;
    List<PredracunGridDto>? filteredPredracuni;
    bool isLoading = false;
    bool isFilterActive = false;

    List<string> komercialistiLookup = new();

    // Stanje multi-select filter
    List<string> stanjeLookup = new();
    HashSet<string> filterStanje = new();
    bool stanjeDropdownOpen = false;

    // Obdobje filter
    public record MesecOpt(int Leto, int Mesec, string Naziv);
    public record CetrtletjeOpt(int Leto, int Q, string Naziv);

    static readonly string[] obdobjaTipi = new[] { "Mesec", "Èetrtletje", "Leto" };
    string izbranTipObdobja = "Mesec";
    List<MesecOpt> meseci = new();
    List<CetrtletjeOpt> cetrtletja = new();
    List<int> leta = new();
    MesecOpt? izbranMesec;
    CetrtletjeOpt? izbranoCetrtletje;
    int? izbranoLeto;

    protected override void OnInitialized()
    {
        BuildObdobjaKoledar();
        var danes = DateTime.Today;
        izbranMesec = meseci.FirstOrDefault(m => m.Leto == danes.Year && m.Mesec == danes.Month)
                      ?? meseci.FirstOrDefault();
    }

    async Task LoadData()
    {
        isLoading = true;
        try
        {
            predracuni = await PredracunService.GetAllPredracuniAsync();
            komercialistiLookup = predracuni
                .Select(p => p.NazivKomercialista)
                .Where(n => !string.IsNullOrWhiteSpace(n))
                .Select(n => n!)
                .Distinct()
                .OrderBy(n => n)
                .ToList();
            stanjeLookup = predracuni
                .Select(p => p.StanjePrikaz ?? string.Empty)
                .Distinct()
                .OrderBy(s => s)
                .ToList();
            ApplyObdobjeFilter();
        }
        finally
        {
            isLoading = false;
        }
    }

    void BuildObdobjaKoledar()
    {
        var danes = DateTime.Today;
        meseci = new List<MesecOpt>();
        for (int i = 0; i < 36; i++)
        {
            var d = new DateTime(danes.Year, danes.Month, 1).AddMonths(-i);
            meseci.Add(new MesecOpt(d.Year, d.Month, $"{d.Month:D2}/{d.Year}"));
        }
        cetrtletja = new List<CetrtletjeOpt>();
        for (int i = 0; i < 12; i++)
        {
            var d = new DateTime(danes.Year, ((danes.Month - 1) / 3) * 3 + 1, 1).AddMonths(-i * 3);
            int q = (d.Month - 1) / 3 + 1;
            cetrtletja.Add(new CetrtletjeOpt(d.Year, q, $"Q{q}/{d.Year}"));
        }
        leta = Enumerable.Range(0, 6).Select(i => danes.Year - i).ToList();
    }

    void BuildObdobjaFrom(IEnumerable<PredracunGridDto>? source)
    {
        if (source == null) return;
        var sDatumom = source.Where(p => p.Datum.HasValue).Select(p => p.Datum!.Value).ToList();
        meseci = sDatumom
            .Select(d => new { d.Year, d.Month })
            .Distinct()
            .OrderByDescending(x => x.Year).ThenByDescending(x => x.Month)
            .Select(x => new MesecOpt(x.Year, x.Month, $"{x.Month:D2}/{x.Year}"))
            .ToList();
        cetrtletja = sDatumom
            .Select(d => new { d.Year, Q = (d.Month - 1) / 3 + 1 })
            .Distinct()
            .OrderByDescending(x => x.Year).ThenByDescending(x => x.Q)
            .Select(x => new CetrtletjeOpt(x.Year, x.Q, $"Q{x.Q}/{x.Year}"))
            .ToList();
        leta = sDatumom
            .Select(d => d.Year)
            .Distinct()
            .OrderByDescending(x => x)
            .ToList();
    }

    void OnTipObdobjaChanged(string v)
    {
        izbranTipObdobja = v;
        izbranMesec = null;
        izbranoCetrtletje = null;
        izbranoLeto = null;
        ApplyObdobjeFilter();
    }

    void OnMesecChanged(MesecOpt v)
    {
        izbranMesec = v;
        ApplyObdobjeFilter();
    }

    void OnCetrtletjeChanged(CetrtletjeOpt v)
    {
        izbranoCetrtletje = v;
        ApplyObdobjeFilter();
    }

    void OnLetoChanged(int? v)
    {
        izbranoLeto = v;
        ApplyObdobjeFilter();
    }

    void ClearObdobje()
    {
        izbranMesec = null;
        izbranoCetrtletje = null;
        izbranoLeto = null;
        ApplyObdobjeFilter();
    }

    IEnumerable<PredracunGridDto> ApplyObdobje(IEnumerable<PredracunGridDto> source)
    {
        if (izbranTipObdobja == "Mesec" && izbranMesec != null)
            return source.Where(p => p.Datum.HasValue && p.Datum.Value.Year == izbranMesec.Leto && p.Datum.Value.Month == izbranMesec.Mesec);
        if (izbranTipObdobja == "Èetrtletje" && izbranoCetrtletje != null)
            return source.Where(p => p.Datum.HasValue && p.Datum.Value.Year == izbranoCetrtletje.Leto && (p.Datum.Value.Month - 1) / 3 + 1 == izbranoCetrtletje.Q);
        if (izbranTipObdobja == "Leto" && izbranoLeto != null)
            return source.Where(p => p.Datum.HasValue && p.Datum.Value.Year == izbranoLeto);
        return source;
    }

    void ApplyObdobjeFilter()
    {
        if (predracuni == null) return;
        IEnumerable<PredracunGridDto> src = predracuni;
        if (isFilterActive)
            src = src.Where(p => (p.Stanje == 2 || p.Stanje == 5) && string.IsNullOrEmpty(p.RacunStatus));
        if (filterStanje.Count > 0)
            src = src.Where(p => filterStanje.Contains(p.StanjePrikaz ?? string.Empty));
        filteredPredracuni = ApplyObdobje(src).ToList();
    }

    void OnStanjeFilterChanged(string s, bool isChecked)
    {
        if (isChecked) filterStanje.Add(s);
        else filterStanje.Remove(s);
        ApplyObdobjeFilter();
    }

    void ClearStanjeFilter()
    {
        filterStanje.Clear();
        ApplyObdobjeFilter();
    }

    string StanjeFilterCaption()
    {
        if (filterStanje.Count == 0) return "(vsa)";
        if (filterStanje.Count == 1)
        {
            var s = filterStanje.First();
            return string.IsNullOrEmpty(s) ? "(prazno)" : s;
        }
        return $"{filterStanje.Count} izbranih";
    }

    void ApplyQuickFilter()
    {
        isFilterActive = true;
        ApplyObdobjeFilter();
    }

    void ClearFilters()
    {
        isFilterActive = false;
        filterStanje.Clear();
        ApplyObdobjeFilter();
    }
}
