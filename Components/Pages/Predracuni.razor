@page "/predracuni"
@using ObracunDb.Data.DTOs
@using ObracunDb.Services
@inject PredracunService PredracunService

<PageTitle>Predračuni</PageTitle>

<div style="display:flex; flex-direction:column; flex:1; min-height:0;">
    <div style="display:flex; flex-direction:row; flex-wrap:nowrap; align-items:center; gap:8px; margin-bottom:8px; flex-shrink:0;">
        <span>Od:</span>
        <select class="form-select form-select-sm" style="width:auto;"
                value="@izbranoObdobjeOd" @onchange="OnObdobjeOdChanged">
            @foreach (var m in meseci)
            {
                <option value="@m.Naziv">@m.Naziv</option>
            }
        </select>
        <span>Do:</span>
        <select class="form-select form-select-sm" style="width:auto;"
                value="@izbranoObdobjeDo" @onchange="OnObdobjeDoChanged">
            @foreach (var m in meseci)
            {
                <option value="@m.Naziv">@m.Naziv</option>
            }
        </select>
        <DxButton Text="Naloži" Click="@LoadData" RenderStyle="ButtonRenderStyle.Primary" />
    </div>

    @if (isLoading)
    {
        <p>Nalagam podatke...</p>
    }
    else if (predracuni == null)
    {
        <p class="text-muted">Izberite obdobje in kliknite <b>Naloži</b>.</p>
    }
    else
    {
    <DxTabs style="flex:1; min-height:0; display:flex; flex-direction:column;">
        <DxTabPage Text="Predračuni">
    <div style="height:calc(100vh - 190px); min-height:0; overflow:hidden;">
    <DxGrid @ref="grid"
            Data="@filteredPredracuni"
            KeyFieldName="@nameof(PredracunGridDto.Key)"
            ShowAllRows="true"
            ShowFilterRow="true"
            ShowFooter="true"
            CssClass="w-100 h-100">
        <Columns>
            <DxGridCommandColumn Caption="" Width="80px" NewButtonVisible="false" EditButtonVisible="false" DeleteButtonVisible="false">
                <CellDisplayTemplate>
                    @{
                        var predracun = (PredracunGridDto)context.DataItem;
                    }
                    <DxButton Text="Info" RenderStyle="ButtonRenderStyle.Info" SizeMode="SizeMode.Small" Click="@(() => ShowPredracunInfoAsync(predracun))" />
                </CellDisplayTemplate>
            </DxGridCommandColumn>
            <DxGridDataColumn FieldName="@nameof(PredracunGridDto.Stevilka)" Caption="Številka" Width="100px" />
            <DxGridDataColumn FieldName="@nameof(PredracunGridDto.Datum)" Caption="Datum" DisplayFormat="dd.MM.yyyy" Width="120px" />
            <DxGridDataColumn FieldName="@nameof(PredracunGridDto.SifraKupca)" Caption="Šifra" Width="100px" />
            <DxGridDataColumn FieldName="@nameof(PredracunGridDto.NazivPartnerja)" Caption="Naziv partnerja" />
            <DxGridDataColumn FieldName="@nameof(PredracunGridDto.NazivKomercialista)" Caption="Komercialist" Width="160px">
                <FilterRowCellTemplate Context="frc">
                    <DxComboBox Data="@komercialistiLookup"
                                Value="@(frc.FilterRowValue as string)"
                                ValueChanged="@((string v) => frc.FilterRowValue = v)"
                                NullText="(vsi)"
                                FilteringMode="DataGridFilteringMode.Contains"
                                ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                CssClass="w-100" />
                </FilterRowCellTemplate>
            </DxGridDataColumn>
            <DxGridDataColumn FieldName="@nameof(PredracunGridDto.ZnesekKoncni)" Caption="Znesek" DisplayFormat="N2" Width="120px" />
            <DxGridDataColumn FieldName="@nameof(PredracunGridDto.Placano)" Caption="Plačano" DisplayFormat="N2" Width="120px" />
            <DxGridDataColumn FieldName="@nameof(PredracunGridDto.PlacanoIzRacunov)" Caption="PlačRač" DisplayFormat="N2" Width="120px" />
            <DxGridDataColumn FieldName="@nameof(PredracunGridDto.RacunStatus)" Caption="Račun" Width="150px" />
            <DxGridDataColumn FieldName="@nameof(PredracunGridDto.PovezaniRacuni)" Caption="Št. računa" Width="120px" />
            <DxGridDataColumn FieldName="@nameof(PredracunGridDto.StanjePrikaz)" Caption="Stanje" Width="160px">
                <FilterRowCellTemplate>
                    <div style="position:relative;">
                        <button type="button" class="btn btn-light btn-sm w-100 text-start"
                                @onclick="@(() => stanjeDropdownOpen = !stanjeDropdownOpen)">
                            @StanjeFilterCaption()
                        </button>
                        @if (stanjeDropdownOpen)
                        {
                            <div style="position:absolute; top:100%; left:0; z-index:1050; background:white; border:1px solid #ccc; padding:8px; min-width:180px; max-height:260px; overflow:auto; box-shadow:0 2px 6px rgba(0,0,0,0.15);">
                                @foreach (var s in stanjeLookup)
                                {
                                    var label = string.IsNullOrEmpty(s) ? "(prazno)" : s;
                                    <div style="padding:2px 0;">
                                        <DxCheckBox Checked="@filterStanje.Contains(s)"
                                                    CheckedChanged="@((bool v) => OnStanjeFilterChanged(s, v))">
                                            @label
                                        </DxCheckBox>
                                    </div>
                                }
                                <div style="margin-top:6px; display:flex; gap:4px;">
                                    <DxButton Text="Počisti" RenderStyle="ButtonRenderStyle.Secondary" Click="@ClearStanjeFilter" />
                                    <DxButton Text="Zapri" RenderStyle="ButtonRenderStyle.Light" Click="@(() => stanjeDropdownOpen = false)" />
                                </div>
                            </div>
                        }
                    </div>
                </FilterRowCellTemplate>
            </DxGridDataColumn>
        </Columns>
        <TotalSummary>
            <DxGridSummaryItem SummaryType="GridSummaryItemType.Count"
                               FieldName="@nameof(PredracunGridDto.Stevilka)"
                               FooterColumnName="@nameof(PredracunGridDto.Stevilka)"
                               DisplayText="Predračunov: {0}" />
            <DxGridSummaryItem SummaryType="GridSummaryItemType.Sum"
                               FieldName="@nameof(PredracunGridDto.ZnesekKoncni)"
                               FooterColumnName="@nameof(PredracunGridDto.ZnesekKoncni)"
                               DisplayText="{0}"
                               ValueDisplayFormat="N2" />
            <DxGridSummaryItem SummaryType="GridSummaryItemType.Sum"
                               FieldName="@nameof(PredracunGridDto.Placano)"
                               FooterColumnName="@nameof(PredracunGridDto.Placano)"
                               DisplayText="{0}"
                               ValueDisplayFormat="N2" />
            <DxGridSummaryItem SummaryType="GridSummaryItemType.Sum"
                               FieldName="@nameof(PredracunGridDto.PlacanoIzRacunov)"
                               FooterColumnName="@nameof(PredracunGridDto.PlacanoIzRacunov)"
                               DisplayText="{0}"
                               ValueDisplayFormat="N2" />
        </TotalSummary>
        <DetailRowTemplate Context="dataItem">
            @{
                var predracun = (PredracunGridDto)dataItem.DataItem;
            }
            <DetailGridComponent Stevilka="@predracun.Stevilka" Leto="@predracun.Leto" />
        </DetailRowTemplate>
    </DxGrid>
    </div>
        </DxTabPage>
        <DxTabPage Text="Graf po tipih">
            <DxTabs>
                <DxTabPage Text="Zneski">
                    <div style="padding:12px 0; min-height:0; overflow:hidden; height:calc(100vh - 230px);">
                        <DxChart Data="@StatistikaFiltered" Height="580px">
                            <DxChartTitle Text="Zneski predračunov po tipih" />
                            <DxChartCommonSeries NameField="@((PredracunStatistikaDto s) => s.Stanje)"
                                                 ArgumentField="@(s => s.Mesec)"
                                                 ValueField="@(s => s.Znesek)"
                                                 SeriesType="ChartSeriesType.StackedBar" />
                            <DxChartArgumentAxis>
                                <DxChartAxisLabel RotationAngle="-45" />
                            </DxChartArgumentAxis>
                            <DxChartLegend Position="RelativePosition.Outside"
                                           HorizontalAlignment="HorizontalAlignment.Right" />
                            <DxChartTooltip Enabled="true" Position="RelativePosition.Outside">
                                <div style="padding:4px 8px;">
                                    <b>@context.Point.SeriesName</b><br />
                                    @context.Point.Argument: @($"{context.Point.Value:N2}") €
                                </div>
                            </DxChartTooltip>
                        </DxChart>
                    </div>
                </DxTabPage>
                <DxTabPage Text="Število predračunov">
                    <div style="padding:12px 0; min-height:0; overflow:hidden; height:calc(100vh - 230px);">
                        <DxChart Data="@StatistikaFiltered" Height="580px">
                            <DxChartTitle Text="Število predračunov po tipih" />
                            <DxChartCommonSeries NameField="@((PredracunStatistikaDto s) => s.Stanje)"
                                                 ArgumentField="@(s => s.Mesec)"
                                                 ValueField="@(s => s.Kolicina)"
                                                 SeriesType="ChartSeriesType.StackedBar" />
                            <DxChartArgumentAxis>
                                <DxChartAxisLabel RotationAngle="-45" />
                            </DxChartArgumentAxis>
                            <DxChartLegend Position="RelativePosition.Outside"
                                           HorizontalAlignment="HorizontalAlignment.Right" />
                            <DxChartTooltip Enabled="true" Position="RelativePosition.Outside">
                                <div style="padding:4px 8px;">
                                    <b>@context.Point.SeriesName</b><br />
                                    @context.Point.Argument: @context.Point.Value predračunov
                                </div>
                            </DxChartTooltip>
                        </DxChart>
                    </div>
                </DxTabPage>
            </DxTabs>
        </DxTabPage>
        <DxTabPage Text="Graf po komercialistih">
            <DxTabs>
                <DxTabPage Text="Zneski">
                    <div style="padding:12px 0; min-height:0; overflow:hidden; height:calc(100vh - 230px);">
                        <DxChart Data="@GrafKomercialistiData" Height="580px">
                            <DxChartTitle Text="Zneski predračunov po komercialistih" />
                            <DxChartCommonSeries NameField="@((PredracunKomercialistGrafDto s) => s.Komercialist)"
                                                 ArgumentField="@(s => s.Mesec)"
                                                 ValueField="@(s => s.Znesek)"
                                                 SeriesType="ChartSeriesType.StackedBar" />
                            <DxChartArgumentAxis>
                                <DxChartAxisLabel RotationAngle="-45" />
                            </DxChartArgumentAxis>
                            <DxChartLegend Position="RelativePosition.Outside"
                                           HorizontalAlignment="HorizontalAlignment.Right" />
                            <DxChartTooltip Enabled="true" Position="RelativePosition.Outside">
                                <div style="padding:4px 8px;">
                                    <b>@context.Point.SeriesName</b><br />
                                    @context.Point.Argument: @($"{context.Point.Value:N2}") €
                                </div>
                            </DxChartTooltip>
                        </DxChart>
                    </div>
                </DxTabPage>
                <DxTabPage Text="Število predračunov">
                    <div style="padding:12px 0; min-height:0; overflow:hidden; height:calc(100vh - 230px);">
                        <DxChart Data="@GrafKomercialistiData" Height="580px">
                            <DxChartTitle Text="Število predračunov po komercialistih" />
                            <DxChartCommonSeries NameField="@((PredracunKomercialistGrafDto s) => s.Komercialist)"
                                                 ArgumentField="@(s => s.Mesec)"
                                                 ValueField="@(s => s.Kolicina)"
                                                 SeriesType="ChartSeriesType.StackedBar" />
                            <DxChartArgumentAxis>
                                <DxChartAxisLabel RotationAngle="-45" />
                            </DxChartArgumentAxis>
                            <DxChartLegend Position="RelativePosition.Outside"
                                           HorizontalAlignment="HorizontalAlignment.Right" />
                            <DxChartTooltip Enabled="true" Position="RelativePosition.Outside">
                                <div style="padding:4px 8px;">
                                    <b>@context.Point.SeriesName</b><br />
                                    @context.Point.Argument: @context.Point.Value predračunov
                                </div>
                            </DxChartTooltip>
                        </DxChart>
                    </div>
                </DxTabPage>
            </DxTabs>
        </DxTabPage>
    </DxTabs>
    }
    </div>

<DxPopup @bind-Visible="@showPredracunInfo"
         HeaderText="@predracunInfoTitle"
         Width="900px"
         CloseOnOutsideClick="true"
         ShowFooter="true">
    <BodyContentTemplate>
        @if (predracunInfoLoading)
        {
            <p>Nalagam podatke...</p>
        }
        else if (!string.IsNullOrWhiteSpace(predracunInfoError))
        {
            <div class="alert alert-danger">@predracunInfoError</div>
        }
        else if (predracunInfo != null)
        {
            <div style="display:flex; flex-direction:column; gap:12px; font-size:0.9rem;">
                <table class="table table-sm table-striped">
                    <tbody>
                        <tr><td><strong>Predračun</strong></td><td>@predracunInfo.Stevilka / @predracunInfo.Leto</td></tr>
                        <tr><td><strong>Znesek</strong></td><td>@predracunInfo.ZnesekKoncni.ToString("N2")</td></tr>
                        <tr><td><strong>STANJE iz FA_PREDRACUN</strong></td><td>@(predracunInfo.Stanje?.ToString() ?? "")</td></tr>
                        <tr><td><strong>Stanje</strong></td><td>@predracunInfo.StanjePrikaz</td></tr>
                        <tr><td><strong>Račun</strong></td><td>@predracunInfo.RacunStatus</td></tr>
                        <tr><td><strong>Št. računa</strong></td><td>@predracunInfo.PovezaniRacuni</td></tr>
                    </tbody>
                </table>

                <div>
                    @if (predracunInfo.Placila.Count == 0)
                    {
                        <p class="text-muted">Ni najdenih plačil.</p>
                    }
                    else
                    {
                        <DxGrid Data="@predracunInfo.Placila" ShowAllRows="true" CssClass="w-100">
                            <Columns>
                                <DxGridBandColumn Caption="Plačilo">
                                    <HeaderCaptionTemplate Context="hdr">
                                        <div style="width:100%; text-align:left;">Plačila</div>
                                    </HeaderCaptionTemplate>
                                    <Columns>
                                        <DxGridDataColumn FieldName="@nameof(PredracunPlaciloInfoDto.Datum)" Caption="Datum" DisplayFormat="dd.MM.yyyy" Width="110px" />
                                        <DxGridDataColumn FieldName="@nameof(PredracunPlaciloInfoDto.Znesek)" Caption="Znesek" DisplayFormat="N2" Width="120px" />
                                        @if (predracunInfo.Placila.Any(p => p.Sconto != 0))
                                        {
                                            <DxGridDataColumn FieldName="@nameof(PredracunPlaciloInfoDto.Sconto)" Caption="Sconto" DisplayFormat="N2" Width="120px" />
                                        }
                                        @if (predracunInfo.Placila.Any(p => p.Skupaj != p.Znesek))
                                        {
                                            <DxGridDataColumn FieldName="@nameof(PredracunPlaciloInfoDto.Skupaj)" Caption="Skupaj" DisplayFormat="N2" Width="120px" />
                                        }
                                    </Columns>
                                </DxGridBandColumn>
                            </Columns>
                        </DxGrid>
                    }
                </div>

                <div>
                    @if (predracunInfo.Racuni.Count == 0)
                    {
                        <p class="text-muted">Ni najdenih povezanih računov.</p>
                    }
                    else
                    {
                        <DxGrid Data="@predracunInfo.Racuni" ShowAllRows="true" CssClass="w-100">
                            <Columns>
                                <DxGridBandColumn Caption="Povezani računi">
                                    <HeaderCaptionTemplate Context="hdr">
                                        <div style="width:100%; text-align:left;">Povezani računi</div>
                                    </HeaderCaptionTemplate>
                                    <Columns>
                                        <DxGridDataColumn FieldName="@nameof(PredracunRacunInfoDto.Stevilka)" Caption="Račun" Width="120px">
                                            <CellDisplayTemplate Context="c">
                                                @{
                                                    var racun = (PredracunRacunInfoDto)c.DataItem;
                                                }
                                                <div style="width:100%; text-align:left;">@racun.Stevilka / @racun.Leto</div>
                                            </CellDisplayTemplate>
                                        </DxGridDataColumn>
                                        <DxGridDataColumn FieldName="@nameof(PredracunRacunInfoDto.Datum)" Caption="Datum" DisplayFormat="dd.MM.yyyy" Width="110px" />
                                        <DxGridDataColumn FieldName="@nameof(PredracunRacunInfoDto.VirPovezave)" Caption="Vir povezave" Width="130px" />
                                        <DxGridDataColumn FieldName="@nameof(PredracunRacunInfoDto.PovezaniZnesek)" Caption="Znesek povezave" DisplayFormat="N2" Width="150px" />
                                    </Columns>
                                </DxGridBandColumn>
                            </Columns>
                        </DxGrid>
                    }
                </div>
            </div>
        }
    </BodyContentTemplate>
    <FooterContentTemplate>
        <DxButton Text="Zapri" RenderStyle="ButtonRenderStyle.Secondary" Click="@(() => showPredracunInfo = false)" />
    </FooterContentTemplate>
</DxPopup>

@code {
    IGrid? grid;
    List<PredracunGridDto>? predracuni;
    List<PredracunGridDto>? filteredPredracuni;
    bool isLoading = false;
    bool showPredracunInfo;
    bool predracunInfoLoading;
    string predracunInfoTitle = "Info predračuna";
    string? predracunInfoError;
    PredracunInfoDto? predracunInfo;

    List<string> komercialistiLookup = new();

    List<PredracunStatistikaDto> StatistikaFiltered => BuildStatistikaFiltered();

    List<PredracunKomercialistGrafDto> GrafKomercialistiData => BuildGrafKomercialistiData();

    // Stanje multi-select filter
    List<string> stanjeLookup = new();
    HashSet<string> filterStanje = new();
    bool stanjeDropdownOpen = false;

    // Obdobje filter
    public record MesecOpt(int Leto, int Mesec, string Naziv);

    List<MesecOpt> meseci = new();
    int mesecOd;
    int letoOd;
    int mesecDo;
    int letoDo;
    string izbranoObdobjeOd = "";
    string izbranoObdobjeDo = "";
    protected override void OnInitialized()
    {
        BuildObdobjaKoledar();
        var prejsnji = DateTime.Today.AddMonths(-1);
        letoOd = letoDo = prejsnji.Year;
        mesecOd = mesecDo = prejsnji.Month;
        izbranoObdobjeOd = izbranoObdobjeDo = $"{mesecOd:D2}/{letoOd}";
    }

    async Task LoadData()
    {
        isLoading = true;
        try
        {
            var odLeta = Math.Min(letoOd, letoDo);
            predracuni = await PredracunService.GetAllPredracuniAsync(odLeta);
            komercialistiLookup = predracuni
                .Select(p => p.NazivKomercialista)
                .Where(n => !string.IsNullOrWhiteSpace(n))
                .Select(n => n!)
                .Distinct()
                .OrderBy(n => n)
                .ToList();
            stanjeLookup = predracuni
                .Select(p => p.StanjePrikaz ?? string.Empty)
                .Distinct()
                .OrderBy(s => s)
                .ToList();
            ApplyObdobjeFilter();
        }
        finally
        {
            isLoading = false;
        }
    }

    async Task ShowPredracunInfoAsync(PredracunGridDto predracun)
    {
        showPredracunInfo = true;
        predracunInfoLoading = true;
        predracunInfoError = null;
        predracunInfo = null;
        predracunInfoTitle = $"Info predračuna {predracun.Stevilka} / {predracun.Leto}";

        try
        {
            predracunInfo = await PredracunService.GetPredracunInfoAsync(predracun.Stevilka, predracun.Leto);
        }
        catch (Exception ex)
        {
            predracunInfoError = ex.Message;
        }
        finally
        {
            predracunInfoLoading = false;
        }
    }

    void BuildObdobjaKoledar()
    {
        var danes = DateTime.Today;
        meseci = new List<MesecOpt>();
        for (int i = 0; i < 36; i++)
        {
            var d = new DateTime(danes.Year, danes.Month, 1).AddMonths(-i);
            meseci.Add(new MesecOpt(d.Year, d.Month, $"{d.Month:D2}/{d.Year}"));
        }
    }

    void OnObdobjeOdChanged(ChangeEventArgs e)
    {
        var val = e.Value?.ToString() ?? "";
        if (TryParseObdobje(val, out var l, out var m))
        {
            mesecOd = m;
            letoOd = l;
            izbranoObdobjeOd = val;
            ApplyObdobjeFilter();
        }
    }

    void OnObdobjeDoChanged(ChangeEventArgs e)
    {
        var val = e.Value?.ToString() ?? "";
        if (TryParseObdobje(val, out var l, out var m))
        {
            mesecDo = m;
            letoDo = l;
            izbranoObdobjeDo = val;
            ApplyObdobjeFilter();
        }
    }

    static bool TryParseObdobje(string val, out int leto, out int mesec)
    {
        leto = 0;
        mesec = 0;
        var parts = val.Split('/');
        return parts.Length == 2
            && int.TryParse(parts[0], out mesec)
            && int.TryParse(parts[1], out leto);
    }

    void NormalizeRange()
    {
        var od = new DateTime(letoOd, mesecOd, 1);
        var doDatum = new DateTime(letoDo, mesecDo, 1);
        if (od <= doDatum) return;

        (letoOd, letoDo) = (letoDo, letoOd);
        (mesecOd, mesecDo) = (mesecDo, mesecOd);
        izbranoObdobjeOd = $"{mesecOd:D2}/{letoOd}";
        izbranoObdobjeDo = $"{mesecDo:D2}/{letoDo}";
    }

    IEnumerable<PredracunGridDto> ApplyObdobje(IEnumerable<PredracunGridDto> source)
    {
        NormalizeRange();
        var od = new DateTime(letoOd, mesecOd, 1);
        var doDatum = new DateTime(letoDo, mesecDo, 1).AddMonths(1);
        return source.Where(p => p.Datum.HasValue && p.Datum.Value >= od && p.Datum.Value < doDatum);
    }

    List<DateTime> GetChartMonths()
    {
        NormalizeRange();
        var months = new List<DateTime>();
        var current = new DateTime(letoOd, mesecOd, 1);
        var last = new DateTime(letoDo, mesecDo, 1);
        while (current <= last)
        {
            months.Add(current);
            current = current.AddMonths(1);
        }
        return months;
    }

    List<PredracunStatistikaDto> BuildStatistikaFiltered()
    {
        var source = filteredPredracuni ?? new();
        var grouped = source
            .Where(p => p.Datum != null)
            .GroupBy(p => new
            {
                MesecDatum = new DateTime(p.Datum!.Value.Year, p.Datum.Value.Month, 1),
                Stanje = string.IsNullOrEmpty(p.StanjePrikaz) ? "Ostalo" : p.StanjePrikaz
            })
            .ToDictionary(g => (g.Key.MesecDatum, g.Key.Stanje), g => new { Kolicina = g.Count(), Znesek = g.Sum(p => p.ZnesekKoncni) });

        var stanja = source
            .Select(p => string.IsNullOrEmpty(p.StanjePrikaz) ? "Ostalo" : p.StanjePrikaz)
            .Distinct()
            .OrderBy(s => s)
            .ToList();

        return GetChartMonths()
            .SelectMany(m => stanja.Select(s =>
            {
                grouped.TryGetValue((m, s), out var value);
                return new PredracunStatistikaDto
                {
                    MesecDatum = m,
                    Mesec = $"{m.Month}/{m.Year}",
                    Stanje = s,
                    Kolicina = value?.Kolicina ?? 0,
                    Znesek = value?.Znesek ?? 0
                };
            }))
            .ToList();
    }

    List<PredracunKomercialistGrafDto> BuildGrafKomercialistiData()
    {
        var source = filteredPredracuni ?? new();
        var grouped = source
            .Where(p => p.Datum != null)
            .GroupBy(p => new
            {
                MesecDatum = new DateTime(p.Datum!.Value.Year, p.Datum.Value.Month, 1),
                Komercialist = string.IsNullOrWhiteSpace(p.NazivKomercialista) ? "Brez komercialista" : p.NazivKomercialista!
            })
            .ToDictionary(g => (g.Key.MesecDatum, g.Key.Komercialist), g => new { Kolicina = g.Count(), Znesek = g.Sum(p => p.ZnesekKoncni) });

        var komercialisti = source
            .Select(p => string.IsNullOrWhiteSpace(p.NazivKomercialista) ? "Brez komercialista" : p.NazivKomercialista!)
            .Distinct()
            .OrderBy(s => s)
            .ToList();

        return GetChartMonths()
            .SelectMany(m => komercialisti.Select(k =>
            {
                grouped.TryGetValue((m, k), out var value);
                return new PredracunKomercialistGrafDto
                {
                    MesecDatum = m,
                    Mesec = $"{m.Month}/{m.Year}",
                    Komercialist = k,
                    Znesek = value?.Znesek ?? 0,
                    Kolicina = value?.Kolicina ?? 0
                };
            }))
            .ToList();
    }

    void ApplyObdobjeFilter()
    {
        if (predracuni == null) return;
        IEnumerable<PredracunGridDto> src = predracuni;
        if (filterStanje.Count > 0)
            src = src.Where(p => filterStanje.Contains(p.StanjePrikaz ?? string.Empty));
        filteredPredracuni = ApplyObdobje(src).ToList();
    }

    void OnStanjeFilterChanged(string s, bool isChecked)
    {
        if (isChecked) filterStanje.Add(s);
        else filterStanje.Remove(s);
        ApplyObdobjeFilter();
    }

    void ClearStanjeFilter()
    {
        filterStanje.Clear();
        ApplyObdobjeFilter();
    }

    string StanjeFilterCaption()
    {
        if (filterStanje.Count == 0) return "(vsa)";
        if (filterStanje.Count == 1)
        {
            var s = filterStanje.First();
            return string.IsNullOrEmpty(s) ? "(prazno)" : s;
        }
        return $"{filterStanje.Count} izbranih";
    }
}
