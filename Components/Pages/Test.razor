@page "/test"
@rendermode InteractiveServer
@inject NavigationManager NavigationManager

<PageTitle>TEST</PageTitle>

<div style="display: flex; flex-direction: column; height: calc(100vh - 4rem); gap: 8px;">
    <h5 style="margin: 0;">TEST</h5>

    <div style="flex: 1; overflow: hidden;">
        <DxGrid Data="@partnerji"
                KeyFieldName="Sifra"
                ShowFilterRow="true"
                AllowSort="true"
                CssClass="w-100"
                PageSize="0"
                VirtualScrollingEnabled="true"
                style="height: 100%">
            <Columns>
                <DxGridDataColumn FieldName="Sifra" Caption="Šifra" Width="100px" />
                <DxGridDataColumn FieldName="Naziv" Caption="Naziv" />
                <DxGridDataColumn FieldName="Naslov" Caption="Naslov" />
                <DxGridDataColumn FieldName="Posta" Caption="Pošta" Width="200px" />
            </Columns>
        </DxGrid>
    </div>

    <div style="flex-shrink: 0; padding: 4px 0;">
        <DxButton Text="Zapri" RenderStyle="ButtonRenderStyle.Secondary" Click="@OnZapri" />
    </div>
</div>

@code {
    static readonly string[] Imena = { "Kovač", "Novak", "Horvat", "Krajnc", "Zupančič", "Potočnik", "Bizjak", "Oblak", "Kos", "Hribar", "Turk", "Golob", "Vidmar", "Korošec", "Breznik", "Gregorič", "Tomšič", "Kastelic", "Mlakar", "Tratnik" };
    static readonly string[] Dejavnosti = { "d.o.o.", "s.p.", "d.d.", "k.d.", "z.o.o." };
    static readonly string[] Ulice = { "Cesta", "Ulica", "Pot", "Trg", "Naselje" };
    static readonly string[] UliceImena = { "svobode", "bratov Martinčič", "na Brdo", "ob Dravi", "Tržaška", "Cankarjeva", "Prešernova", "Gregorčičeva", "Aškerčeva", "Titova", "Partizanska", "Kidričeva", "Bevkova", "Šolska", "Maistrova" };
    static readonly string[] Kraji = { "1000 Ljubljana", "2000 Maribor", "3000 Celje", "4000 Kranj", "5000 Nova Gorica", "6000 Koper", "8000 Novo mesto", "9000 Murska Sobota", "2250 Ptuj", "3320 Velenje", "1230 Domžale", "4260 Bled", "6210 Sežana", "1420 Trbovlje", "2380 Slovenj Gradec", "3210 Slovenske Konjice", "8250 Brežice", "1270 Litija", "5270 Ajdovščina", "6230 Postojna" };

    List<TestPartnerDto> partnerji = new();

    protected override void OnInitialized()
    {
        var rnd = new Random(42);
        for (int i = 1; i <= 1000; i++)
        {
            var ime = Imena[rnd.Next(Imena.Length)];
            var dejavnost = Dejavnosti[rnd.Next(Dejavnosti.Length)];
            var ulica = $"{Ulice[rnd.Next(Ulice.Length)]} {UliceImena[rnd.Next(UliceImena.Length)]} {rnd.Next(1, 150)}";
            var kraj = Kraji[rnd.Next(Kraji.Length)];

            partnerji.Add(new TestPartnerDto
            {
                Sifra = i,
                Naziv = $"{ime} {dejavnost}",
                Naslov = ulica,
                Posta = kraj
            });
        }
    }

    void OnZapri()
    {
        NavigationManager.NavigateTo("/");
    }

    class TestPartnerDto
    {
        public int Sifra { get; set; }
        public string? Naziv { get; set; }
        public string? Naslov { get; set; }
        public string? Posta { get; set; }
    }
}
