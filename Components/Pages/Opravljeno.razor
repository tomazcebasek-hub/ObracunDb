@page "/osnutki"
@rendermode InteractiveServer
@using ObracunDb.Data.DTOs
@using ObracunDb.Data.Entities
@using ObracunDb.Services
@inject ParametriService Parametri
@inject ObracunService ObracunService
@inject PartnerMinuteService PartnerMinuteService
@inject ObracunOsnutekSpremembaService SpremembaService
@inject ArtikelService ArtikelService
@inject IJSRuntime JS
@using Microsoft.AspNetCore.Components.Sections

<PageTitle>Osnutki</PageTitle>

<SectionContent SectionName="PageHeaderExtra">
    <span class="ms-2 text-muted">@_mesec/@_leto</span>
</SectionContent>

@if (isLoading)
{
    <p>Nalagam podatke...</p>
}
else if (errorMessage != null)
{
    <div class="alert alert-danger">
        <p>@errorMessage</p>
    </div>
}
else
{
    <!-- Zgornji del 40% -->
    <DxGrid @ref="gridPartnerji"
            Data="@podatki"
            KeyFieldName="@nameof(OsnutekPartnerDto.Sifra)"
            ShowAllRows="true"
            ShowFilterRow="true"
            FocusedRowChanged="@OnPartnerSelected"
            FocusedRowEnabled="true"
            VirtualScrollingEnabled="true"
            CssClass="w-100"
            style="height: 40vh;">
            <Columns>
                <DxGridDataColumn FieldName="@nameof(OsnutekPartnerDto.Sifra)" Caption="Šifra" Width="80px" />
                <DxGridDataColumn FieldName="@nameof(OsnutekPartnerDto.NazivPartnerja)" Caption="Partner" />
                <DxGridDataColumn FieldName="@nameof(OsnutekPartnerDto.ImaPogodbo)" Caption="Pog" Width="55px">
                    <CellDisplayTemplate>
                        @{ var pog = (bool)(context.Value ?? false); }
                        @(pog ? "Da" : "")
                    </CellDisplayTemplate>
                </DxGridDataColumn>
                <DxGridDataColumn FieldName="@nameof(OsnutekPartnerDto.ImaPredracun)" Caption="Pred" Width="55px">
                    <CellDisplayTemplate>
                        @{ var pred = (bool)(context.Value ?? false); }
                        @(pred ? "Da" : "")
                    </CellDisplayTemplate>
                </DxGridDataColumn>
                <DxGridDataColumn FieldName="@nameof(OsnutekPartnerDto.ImaNaloge)" Caption="Nal" Width="55px">
                    <CellDisplayTemplate>
                        @{ var nal = (bool)(context.Value ?? false); }
                        @(nal ? "Da" : "")
                    </CellDisplayTemplate>
                </DxGridDataColumn>
                <DxGridDataColumn FieldName="@nameof(OsnutekPartnerDto.Minute)" Caption="Minute" Width="75px" />
                <DxGridDataColumn FieldName="@nameof(OsnutekPartnerDto.MinNeobr)" Caption="MinNeobr" Width="85px" />
                <DxGridDataColumn FieldName="@nameof(OsnutekPartnerDto.KorPog)" Caption="KorPog" Width="75px" />
                <DxGridDataColumn FieldName="@nameof(OsnutekPartnerDto.KorPre)" Caption="KorPre" Width="75px" />
                <DxGridDataColumn FieldName="@nameof(OsnutekPartnerDto.KorRoc)" Caption="KorRoč" Width="75px" />
                <DxGridDataColumn FieldName="@nameof(OsnutekPartnerDto.KorPar)" Caption="KorPar" Width="75px" />
                <DxGridDataColumn FieldName="@nameof(OsnutekPartnerDto.ZaracMin)" Caption="ZaračMin" Width="85px" />
                <DxGridDataColumn FieldName="@nameof(OsnutekPartnerDto.PotrdilKdo)" Caption="Potrdil" Width="100px" />
                <DxGridDataColumn FieldName="@nameof(OsnutekPartnerDto.PotrdilKdaj)" Caption="Kdaj" DisplayFormat="dd.MM.yyyy HH:mm" Width="135px" />
            </Columns>
            <TotalSummary>
                <DxGridSummaryItem SummaryType="GridSummaryItemType.Count" FieldName="@nameof(OsnutekPartnerDto.Sifra)" DisplayText="Partnerjev: {0}" />
                <DxGridSummaryItem SummaryType="GridSummaryItemType.Sum" FieldName="@nameof(OsnutekPartnerDto.Minute)" DisplayText="{0}" />
                <DxGridSummaryItem SummaryType="GridSummaryItemType.Sum" FieldName="@nameof(OsnutekPartnerDto.MinNeobr)" DisplayText="{0}" />
                <DxGridSummaryItem SummaryType="GridSummaryItemType.Sum" FieldName="@nameof(OsnutekPartnerDto.KorPog)" DisplayText="{0}" />
                <DxGridSummaryItem SummaryType="GridSummaryItemType.Sum" FieldName="@nameof(OsnutekPartnerDto.KorPre)" DisplayText="{0}" />
                <DxGridSummaryItem SummaryType="GridSummaryItemType.Sum" FieldName="@nameof(OsnutekPartnerDto.KorRoc)" DisplayText="{0}" />
                <DxGridSummaryItem SummaryType="GridSummaryItemType.Sum" FieldName="@nameof(OsnutekPartnerDto.KorPar)" DisplayText="{0}" />
                <DxGridSummaryItem SummaryType="GridSummaryItemType.Sum" FieldName="@nameof(OsnutekPartnerDto.ZaracMin)" DisplayText="{0}" />
            </TotalSummary>
        </DxGrid>

    <div class="d-flex gap-2 align-items-center" style="padding: 4px 0;">
        @if (selectedPartner != null && string.IsNullOrEmpty(selectedPartner.PotrdilKdo))
        {
            <DxButton Text="Potrdi" 
                      Click="@PotrdiOsnutek" 
                      RenderStyle="ButtonRenderStyle.Success" />
        }
        <DxButton Text="@(pokaziVse ? "Samo nepotrjeni" : "Prikaži vse")" 
                  Click="@OnTogglePrikaziVse" 
                  RenderStyle="@(pokaziVse ? ButtonRenderStyle.Info : ButtonRenderStyle.Light)" />
        <span class="text-muted ms-auto" style="font-size: 0.85rem;">
            Vseh: @StVseh | Potrjenih: @StPotrjenih
        </span>
    </div>

    <hr class="my-2" />

    <!-- Spodnji del 60% -->
    <div style="height: 55vh; display: flex; gap: 8px;">
        <!-- Levi del - zavihki -->
        <div style="flex: 1; overflow: auto;">
            @if (selectedPartner != null)
            {
                <DxTabs ActiveTabIndex="@activeTabIndex" ActiveTabIndexChanged="@OnTabChanged">
                    <DxTab Text="Info" />
                    <DxTab Text="Obračunani nalogi" />
                    <DxTab Text="Neobračunani nalogi" />
                    <DxTab Text="Pogodbe" />
                    <DxTab Text="Predračuni" />
                    <DxTab Text="Računi" />
                    <DxTab Text="Avansi" />
                    <DxTab Text="Ročni" />
                </DxTabs>

                @if (activeTabIndex == 0)
                {
                    <div style="display:flex; flex-direction:column; height:100%;">
                        <div style="flex:2; overflow:auto;">
                            <div class="mt-2" style="white-space: pre-wrap; font-family: monospace; font-size: 0.85rem;">Skupaj minute : @selectedPartner.Minute (za obračun @selectedPartner.MinuteObracunaneBruto, se ne zaračunajo @selectedPartner.MinNeobr)
Število pogodb: @selectedPartner.SteviloPogodb
Skupaj minute v plus: @selectedPartner.SkupajMinuteVPlus
- predračuni      : @selectedPartner.VseMinutePredracun, od tega že @selectedPartner.ZePorabljenePredracun, preostane @selectedPartner.PlusMinutePredracun, koriščeno @selectedPartner.KorPre
- ročni           : @selectedPartner.PlusMinuteRocno, koriščeno @selectedPartner.KorRoc
- pogodbe         : @selectedPartner.PlusMinutePogodba, koriščeno @selectedPartner.KorPog
- partner minute  : @selectedPartner.VseMinutePartnerMinute, od tega že @selectedPartner.ZePorabljenePartnerMinute, preostane @selectedPartner.PlusMinutePartnerMinute, koriščeno @selectedPartner.KorPar
Za obračun       : @selectedPartner.ZaracMin minut</div>
                        </div>
                        <div style="flex:1; display:flex; flex-direction:column; justify-content:center; padding:8px 0;">
                            @{
                                var total = selectedPartner.Minute;
                                var segments = new (int Value, string Color, string Label)[]
                                {
                                    (selectedPartner.MinNeobr, "#9E9E9E", "Se ne obračunajo"),
                                    (selectedPartner.KorPre, "#42A5F5", "Koriščeno predračuni"),
                                    (selectedPartner.KorRoc, "#66BB6A", "Koriščeno ročni"),
                                    (selectedPartner.KorPog, "#FFA726", "Koriščeno pogodbe"),
                                    (selectedPartner.KorPar, "#AB47BC", "Koriščeno partner minute"),
                                    (selectedPartner.ZaracMin, "#EF5350", "Obračunano")
                                };
                            }
                            @if (total > 0)
                            {
                                <div style="display:flex; height:28px; width:100%; border-radius:4px; overflow:hidden; border:1px solid #ccc;">
                                    @foreach (var seg in segments)
                                    {
                                        if (seg.Value > 0)
                                        {
                                            var pct = (double)seg.Value / total * 100;
                                            <div style="width:@(pct.ToString("F1", System.Globalization.CultureInfo.InvariantCulture))%; background:@seg.Color; height:100%;"
                                                 title="@seg.Label: @seg.Value min (@(pct.ToString("F0")) %)"></div>
                                        }
                                    }
                                </div>
                                <div style="font-size:0.75rem; color:#666; margin-top:4px;">
                                    Skupaj: @total min
                                </div>
                            }
                            else
                            {
                                <div style="font-size:0.8rem; color:#999;">Ni minut.</div>
                            }
                        </div>
                    </div>
                }
                else if (activeTabIndex == 1 || activeTabIndex == 2)
                {
                    <DxGrid Data="@nalogi"
                        KeyFieldName="@nameof(NalogGridDto.Key)"
                        ShowAllRows="true"
                        FocusedRowEnabled="true"
                        FocusedRowChanged="@OnNalogSelected"
                        CssClass="w-100 mt-1">
                    <Columns>
                        <DxGridDataColumn FieldName="@nameof(NalogGridDto.Stevilka)" Caption="Številka" Width="90px" />
                        <DxGridDataColumn FieldName="@nameof(NalogGridDto.NazivPotnika)" Caption="Potnik" Width="140px" />
                        <DxGridDataColumn FieldName="@nameof(NalogGridDto.Datum)" Caption="Datum" DisplayFormat="dd.MM.yyyy" Width="100px" />
                        <DxGridDataColumn FieldName="@nameof(NalogGridDto.ZacetekUra)" Caption="Začetek" DisplayFormat="HH:mm" Width="70px" />
                        <DxGridDataColumn FieldName="@nameof(NalogGridDto.KonecUra)" Caption="Konec" DisplayFormat="HH:mm" Width="70px" />
                        <DxGridDataColumn FieldName="@nameof(NalogGridDto.Minute)" Caption="Minute" Width="70px" />
                    </Columns>
                    </DxGrid>
                }
                else if (activeTabIndex == 3)
                {
                    <DxGrid Data="@pogodbe"
                        KeyFieldName="@nameof(PogodbaGridDto.Key)"
                        ShowAllRows="true"
                        FocusedRowEnabled="true"
                        FocusedRowChanged="@OnPogodbaSelected"
                        CssClass="w-100 mt-1">
                    <Columns>
                        <DxGridDataColumn FieldName="@nameof(PogodbaGridDto.SifNaprejNazaj)" Caption="Tip" Width="60px" />
                        <DxGridDataColumn FieldName="@nameof(PogodbaGridDto.Stevilka)" Caption="Št." Width="60px" />
                        <DxGridDataColumn FieldName="@nameof(PogodbaGridDto.Leto)" Caption="Leto" Width="55px" />
                        <DxGridDataColumn FieldName="@nameof(PogodbaGridDto.StPogodbe)" Caption="Št.pog." Width="80px" />
                        <DxGridDataColumn FieldName="@nameof(PogodbaGridDto.PrviRacunOd)" Caption="Od" DisplayFormat="dd.MM.yyyy" Width="95px" />
                        <DxGridDataColumn FieldName="@nameof(PogodbaGridDto.VeljaDo)" Caption="Do" DisplayFormat="dd.MM.yyyy" Width="95px" />
                        <DxGridDataColumn FieldName="@nameof(PogodbaGridDto.NaKolikoMesecev)" Caption="Mes" Width="50px" />
                        <DxGridDataColumn FieldName="@nameof(PogodbaGridDto.StMinut)" Caption="Min" Width="50px" />
                        <DxGridDataColumn FieldName="@nameof(PogodbaGridDto.Opomba)" Caption="Opomba" />
                    </Columns>
                    </DxGrid>
                }
                else if (activeTabIndex == 4)
                {
                    <DxGrid Data="@predracuni"
                        KeyFieldName="@nameof(PredracunGridDto.Key)"
                        ShowAllRows="true"
                        FocusedRowEnabled="true"
                        FocusedRowChanged="@OnPredracunSelected"
                        CssClass="w-100 mt-1">
                    <Columns>
                        <DxGridDataColumn FieldName="@nameof(PredracunGridDto.Stevilka)" Caption="Številka" Width="90px" />
                        <DxGridDataColumn FieldName="@nameof(PredracunGridDto.Leto)" Caption="Leto" Width="55px" />
                        <DxGridDataColumn FieldName="@nameof(PredracunGridDto.Datum)" Caption="Datum" DisplayFormat="dd.MM.yyyy" Width="95px" />
                        <DxGridDataColumn FieldName="@nameof(PredracunGridDto.ZnesekBrezDdv)" Caption="Znesek" DisplayFormat="N2" Width="95px" />
                        <DxGridDataColumn FieldName="@nameof(PredracunGridDto.Minute)" Caption="Min" Width="55px" />
                        <DxGridDataColumn FieldName="@nameof(PredracunGridDto.MinutePreostalo)" Caption="Preost." Width="65px" />
                        <DxGridDataColumn FieldName="@nameof(PredracunGridDto.StanjePrikaz)" Caption="Status" Width="80px" />
                        <DxGridDataColumn FieldName="@nameof(PredracunGridDto.PovezaniRacuni)" Caption="Račun" Width="80px" />
                    </Columns>
                    </DxGrid>
                }
                else if (activeTabIndex == 5)
                {
                    <DxGrid Data="@racuni"
                        KeyFieldName="@nameof(RacunGridDto.Key)"
                        ShowAllRows="true"
                        FocusedRowEnabled="true"
                        FocusedRowChanged="@OnRacunSelected"
                        CssClass="w-100 mt-1">
                    <Columns>
                        <DxGridDataColumn FieldName="@nameof(RacunGridDto.Stevilka)" Caption="Številka" Width="90px" />
                        <DxGridDataColumn FieldName="@nameof(RacunGridDto.Datum)" Caption="Datum" DisplayFormat="dd.MM.yyyy" Width="100px" />
                        <DxGridDataColumn FieldName="@nameof(RacunGridDto.ZnesekKoncni)" Caption="Končni znesek" DisplayFormat="N2" Width="120px" />
                    </Columns>
                    </DxGrid>
                }
                else if (activeTabIndex == 6)
                {
                    <DxGrid Data="@avansi"
                        KeyFieldName="@nameof(RacunGridDto.Key)"
                        ShowAllRows="true"
                        FocusedRowEnabled="true"
                        FocusedRowChanged="@OnAvansSelected"
                        CssClass="w-100 mt-1">
                    <Columns>
                        <DxGridDataColumn FieldName="@nameof(RacunGridDto.Stevilka)" Caption="Številka" Width="90px" />
                        <DxGridDataColumn FieldName="@nameof(RacunGridDto.Datum)" Caption="Datum" DisplayFormat="dd.MM.yyyy" Width="100px" />
                        <DxGridDataColumn FieldName="@nameof(RacunGridDto.ZnesekKoncni)" Caption="Končni znesek" DisplayFormat="N2" Width="120px" />
                    </Columns>
                    </DxGrid>
                }
                else if (activeTabIndex == 7)
                {
                    <DxGrid Data="@rocnePostavke"
                        KeyFieldName="@nameof(RocnaPostavkaGridDto.Key)"
                        ShowAllRows="true"
                        CssClass="w-100 mt-1">
                    <Columns>
                        <DxGridDataColumn FieldName="@nameof(RocnaPostavkaGridDto.NalogStevilka)" Caption="Številka naloga" Width="120px" />
                        <DxGridDataColumn FieldName="@nameof(RocnaPostavkaGridDto.DatumNaloga)" Caption="Datum" DisplayFormat="dd.MM.yyyy" Width="100px" />
                        <DxGridDataColumn FieldName="@nameof(RocnaPostavkaGridDto.Artikel)" Caption="Artikel" Width="100px" />
                        <DxGridDataColumn FieldName="@nameof(RocnaPostavkaGridDto.NazivArtikla)" Caption="Naziv artikla" />
                        <DxGridDataColumn FieldName="@nameof(RocnaPostavkaGridDto.Kolicina)" Caption="Količina" Width="80px" />
                        <DxGridDataColumn FieldName="@nameof(RocnaPostavkaGridDto.ProdajnaCena)" Caption="Cena" DisplayFormat="N2" Width="80px" />
                        <DxGridDataColumn FieldName="@nameof(RocnaPostavkaGridDto.Minute)" Caption="Minute" Width="80px" />
                    </Columns>
                    <TotalSummary>
                        <DxGridSummaryItem SummaryType="GridSummaryItemType.Sum" FieldName="@nameof(RocnaPostavkaGridDto.Minute)" DisplayText="{0}" />
                    </TotalSummary>
                    </DxGrid>
                }
            }
            else
            {
                <p class="text-muted mt-2">Izberite partnerja v zgornjem gridu.</p>
            }
        </div>

        <!-- Desni del -->
        <div style="flex: 1; overflow: auto; padding: 8px;">
            @if (selectedPartner != null && activeTabIndex == 0)
            {
                <div @oncontextmenu="OnPostavkaContextMenu" @oncontextmenu:preventDefault="true">
                <DxGrid Data="@postavke"
                        KeyFieldName="@nameof(OsnutekPosGridDto.Zs)"
                        ShowAllRows="true"
                        FocusedRowEnabled="true"
                        FocusedRowChanged="@OnPostavkaFocused"
                        CssClass="w-100">
                    <Columns>
                        <DxGridDataColumn FieldName="@nameof(OsnutekPosGridDto.Artikel)" Caption="Artikel" Width="90px" />
                        <DxGridDataColumn FieldName="@nameof(OsnutekPosGridDto.NazivArtikla)" Caption="Naziv" />
                        <DxGridDataColumn FieldName="@nameof(OsnutekPosGridDto.EnotaArtikla)" Caption="Enota" Width="60px" />
                        <DxGridDataColumn FieldName="@nameof(OsnutekPosGridDto.Kolicina)" Caption="Količina" DisplayFormat="N2" Width="90px" />
                        <DxGridDataColumn FieldName="@nameof(OsnutekPosGridDto.Cena)" Caption="Cena" DisplayFormat="N2" Width="90px" />
                        <DxGridDataColumn FieldName="@nameof(OsnutekPosGridDto.Rabat)" Caption="Rabat" DisplayFormat="N2" Width="70px" />
                        <DxGridDataColumn FieldName="@nameof(OsnutekPosGridDto.Vrednost)" Caption="Vrednost" DisplayFormat="N2" Width="100px" />
                    </Columns>
                    <TotalSummary>
                        <DxGridSummaryItem SummaryType="GridSummaryItemType.Sum" FieldName="@nameof(OsnutekPosGridDto.Kolicina)" DisplayText="{0:N2}" />
                        <DxGridSummaryItem SummaryType="GridSummaryItemType.Sum" FieldName="@nameof(OsnutekPosGridDto.Vrednost)" DisplayText="{0:N2}" />
                    </TotalSummary>
                </DxGrid>
                @if (showPostavkaMenu)
                {
                    <div @onclick="@(() => showPostavkaMenu = false)" @oncontextmenu="@(() => showPostavkaMenu = false)" @oncontextmenu:preventDefault="true"
                         style="position:fixed; top:0; left:0; right:0; bottom:0; z-index:1499;"></div>
                    <div class="postavka-ctx-menu"
                         style="@($"position:fixed; top:{postavkaMenuY}px; left:{postavkaMenuX}px; z-index:1500; background:white; border:1px solid #ccc; box-shadow:0 2px 6px rgba(0,0,0,0.2); padding:4px 0; min-width:160px;")">
                        <div style="padding:6px 12px; cursor:pointer;"
                             @onclick="StornoFromPostavka"
                             onmouseover="this.style.background='#eee'"
                             onmouseout="this.style.background='white'">
                            Naredi storno
                        </div>
                    </div>
                }
                </div>
            }
            else if (activeTabIndex == 3 && selectedPogodba != null)
            {
                <DxGrid Data="@pogodbePozicije"
                        KeyFieldName="@nameof(PogodbaPozGridDto.Pozicija)"
                        ShowAllRows="true"
                        CssClass="w-100">
                    <Columns>
                        <DxGridDataColumn FieldName="@nameof(PogodbaPozGridDto.Sifra)" Caption="Šifra" Width="100px" />
                        <DxGridDataColumn FieldName="@nameof(PogodbaPozGridDto.Naziv)" Caption="Naziv" />
                        <DxGridDataColumn FieldName="@nameof(PogodbaPozGridDto.Kolicina)" Caption="Kol" DisplayFormat="N2" Width="70px" />
                        <DxGridDataColumn FieldName="@nameof(PogodbaPozGridDto.Cena)" Caption="Cena" DisplayFormat="N2" Width="90px" />
                        <DxGridDataColumn FieldName="@nameof(PogodbaPozGridDto.Rabat)" Caption="Rabat" DisplayFormat="N1" Width="65px" />
                        <DxGridDataColumn FieldName="@nameof(PogodbaPozGridDto.Meseci)" Caption="Meseci" Width="200px" />
                    </Columns>
                </DxGrid>
            }
            else if (activeTabIndex == 4 && selectedPredracun != null)
            {
                <DxGrid Data="@predracunPostavke"
                        KeyFieldName="@nameof(PredracunKnjizbaGridDto.Zs)"
                        ShowAllRows="true"
                        CssClass="w-100">
                    <Columns>
                        <DxGridDataColumn FieldName="@nameof(PredracunKnjizbaGridDto.SifraArtikla)" Caption="Šifra" Width="90px" />
                        <DxGridDataColumn FieldName="@nameof(PredracunKnjizbaGridDto.NazivArtikla)" Caption="Naziv" />
                        <DxGridDataColumn FieldName="@nameof(PredracunKnjizbaGridDto.Kolicina)" Caption="Količina" DisplayFormat="N2" Width="85px" />
                        <DxGridDataColumn FieldName="@nameof(PredracunKnjizbaGridDto.ProdajnaCena)" Caption="Cena" DisplayFormat="N2" Width="85px" />
                        <DxGridDataColumn FieldName="@nameof(PredracunKnjizbaGridDto.Rabat1)" Caption="Rabat" DisplayFormat="N2" Width="65px" />
                        <DxGridDataColumn FieldName="@nameof(PredracunKnjizbaGridDto.ProdajnaVrednost)" Caption="Vrednost" DisplayFormat="N2" Width="95px" />
                    </Columns>
                </DxGrid>
            }
            else if ((activeTabIndex == 5 || activeTabIndex == 6) && selectedRacunPostavke.Count > 0)
            {
                <DxGrid Data="@selectedRacunPostavke"
                        KeyFieldName="@nameof(RacunKnjizbaDto.Zs)"
                        ShowAllRows="true"
                        CssClass="w-100">
                    <Columns>
                        <DxGridDataColumn FieldName="@nameof(RacunKnjizbaDto.SifraArtikla)" Caption="Artikel" Width="90px" />
                        <DxGridDataColumn FieldName="@nameof(RacunKnjizbaDto.NazivArtikla)" Caption="Naziv" />
                        <DxGridDataColumn FieldName="@nameof(RacunKnjizbaDto.Enota)" Caption="EM" Width="60px" />
                        <DxGridDataColumn FieldName="@nameof(RacunKnjizbaDto.Kolicina)" Caption="Količina" DisplayFormat="N2" Width="90px" />
                        <DxGridDataColumn FieldName="@nameof(RacunKnjizbaDto.ProdajnaCena)" Caption="Cena" DisplayFormat="N2" Width="90px" />
                        <DxGridDataColumn FieldName="@nameof(RacunKnjizbaDto.ProdajnaVrednost)" Caption="Vrednost" DisplayFormat="N2" Width="100px" />
                        <DxGridDataColumn FieldName="@nameof(RacunKnjizbaDto.Rabat1)" Caption="Rabat" DisplayFormat="N2" Width="70px" />
                        <DxGridDataColumn FieldName="@nameof(RacunKnjizbaDto.NetoVrednost)" Caption="Neto" DisplayFormat="N2" Width="100px" />
                    </Columns>
                    <TotalSummary>
                        <DxGridSummaryItem SummaryType="GridSummaryItemType.Sum" FieldName="@nameof(RacunKnjizbaDto.ProdajnaVrednost)" DisplayText="{0:N2}" />
                        <DxGridSummaryItem SummaryType="GridSummaryItemType.Sum" FieldName="@nameof(RacunKnjizbaDto.NetoVrednost)" DisplayText="{0:N2}" />
                    </TotalSummary>
                </DxGrid>
            }
            else if (selectedNalog != null)
            {
                <div style="white-space: pre-wrap;">@selectedNalog.Opis</div>
            }
        </div>
    </div>

    <!-- Spodnja vrstica z gumbi -->
    <div class="d-flex gap-2 mt-2">
        <DxButton Text="Info" RenderStyle="ButtonRenderStyle.Info" Click="@(() => showInfoPopup = true)" />
        <DxButton Text="Korektura" RenderStyle="ButtonRenderStyle.Warning" Enabled="@(selectedPartner != null)" Click="@OpenKorektura" />
        <DxButton Text="Sprememba količine" RenderStyle="ButtonRenderStyle.Warning" Enabled="@(selectedPartner != null)" Click="@OpenSpremembe" />
        <DxButton Text="@($"Obdobje ({_mesec}/{_leto})")"
                  RenderStyle="ButtonRenderStyle.Dark"
                  Click="@OpenObdobje" />
        <DxButton Text="@copyNalogiText" RenderStyle="ButtonRenderStyle.Success" Enabled="@(selectedPartner != null)" Click="@CopyNalogi" />
        <DxButton Text="CALC" RenderStyle="ButtonRenderStyle.Light" Enabled="@(selectedPartner != null && !string.IsNullOrEmpty(selectedPartner?.Opis))" Click="@(() => showCalcPopup = true)" />
    </div>

    @* === CALC popup (log porabe minut) === *@
    <DxPopup @bind-Visible="@showCalcPopup"
             HeaderText="Log obračuna"
             Width="75vw"
             Height="75vh"
             CloseOnOutsideClick="true"
             ShowFooter="true">
        <BodyContentTemplate>
            @if (!string.IsNullOrEmpty(selectedPartner?.Opis))
            {
                <div style="white-space:pre-wrap; font-family:monospace; font-size:0.75rem; height:100%; overflow:auto;">@selectedPartner.Opis</div>
            }
        </BodyContentTemplate>
