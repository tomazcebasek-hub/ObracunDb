                errorMessage = $"Napaka pri nalaganju pogodb: {ex.Message}";
            }
        }
        else if (activeTabIndex == 4)
        {
            predracuni = new();
            predracunPostavke = new();
            selectedPredracun = null;
            try
            {
                predracuni = await ObracunService.GetPredracuniZaPartnerjaAsync(selectedPartner.Sifra, _mesec, _leto);
            }
            catch (Exception ex)
            {
                errorMessage = $"Napaka pri nalaganju predračunov: {ex.Message}";
            }
        }
        else if (activeTabIndex == 5)
        {
            racuni = new();
