    // === Korektura (PartnerMinute za izbranega partnerja) ===
    bool showKorekturaPopup;
    string korekturaTitle = "";
    List<PartnerMinuteGridDto>? korekturaData;

    bool showKorekturaEditDialog;
    string korekturaEditTitle = "";
    string? korEditError;
    int? korEditId;
    decimal korEditMinut;
    int korEditVeljavnost = 1;
    int? korEditZacetekMesec;
    int? korEditZacetekLeto;
    string? korEditOpomba;

    bool showKorekturaDeleteDialog;
    int? korDeleteId;

    string korekturaPartnerDisplay =>
        selectedPartner != null ? $"{selectedPartner.Sifra} - {selectedPartner.NazivPartnerja}" : "";

    bool showPorabaPopup;
    string porabaTitle = "";
    List<PorabaMesecDto>? porabaData;

    void ShowPorabaMesecih(PartnerMinuteGridDto item)
    {
        porabaTitle = $"Poraba minut — ID {item.Id} ({item.Minut:N0} min)";
        porabaData = item.PorabaPoMesecih
            .Where(m => m.Leto < _leto || (m.Leto == _leto && m.Mesec < _mesec))
            .ToList();
        showPorabaPopup = true;
    }

    async Task OpenKorektura()
    {
        if (selectedPartner == null) return;
        korekturaTitle = $"Partner minute — {selectedPartner.Sifra} {selectedPartner.NazivPartnerja}";
        korekturaData = await PartnerMinuteService.GetByPartnerAsync(selectedPartner.Sifra, _mesec, _leto);
        showKorekturaPopup = true;
    }

    void CloseKorektura()
    {
        showKorekturaPopup = false;
    }

    void KorekturaAdd()
    {
        korekturaEditTitle = "Nov vnos partner minut";
        korEditError = null;
        korEditId = null;
        korEditMinut = 0;
        korEditVeljavnost = 1;
        korEditZacetekMesec = _mesec;
        korEditZacetekLeto = _leto;
        korEditOpomba = null;
        showKorekturaEditDialog = true;
    }

    void KorekturaEdit(PartnerMinuteGridDto item)
    {
        korekturaEditTitle = "Uredi partner minute";
        korEditError = null;
        korEditId = item.Id;
        korEditMinut = item.Minut;
        korEditVeljavnost = item.VeljavnostMesecih;
        korEditZacetekMesec = item.ZacetekMesec;
        korEditZacetekLeto = item.ZacetekLeto;
        korEditOpomba = item.Opomba;
        showKorekturaEditDialog = true;
    }

    async Task KorekturaSave()
    {
        if (selectedPartner == null) return;

        if (korEditMinut <= 0)
        {
            korEditError = "Število minut mora biti večje od 0.";
            return;
        }
        korEditError = null;

        try
        {
            if (korEditId.HasValue)
            {
                await PartnerMinuteService.UpdateAsync(korEditId.Value, selectedPartner.Sifra, korEditMinut, korEditVeljavnost, korEditOpomba, korEditZacetekMesec, korEditZacetekLeto);
            }
            else
            {
                await PartnerMinuteService.AddAsync(selectedPartner.Sifra, korEditMinut, korEditVeljavnost, korEditOpomba, korEditZacetekMesec, korEditZacetekLeto);
            }

            showKorekturaEditDialog = false;
            korekturaData = await PartnerMinuteService.GetByPartnerAsync(selectedPartner.Sifra, _mesec, _leto);
        }
        catch (Exception ex)
        {
            errorMessage = $"Napaka pri shranjevanju: {ex.Message}";
        }
    }

    void KorekturaShowDelete(PartnerMinuteGridDto item)
    {
        korDeleteId = item.Id;
        showKorekturaDeleteDialog = true;
    }

    async Task KorekturaDelete()
    {
        if (!korDeleteId.HasValue || selectedPartner == null) return;

        try
        {
            await PartnerMinuteService.DeleteAsync(korDeleteId.Value);
            showKorekturaDeleteDialog = false;
            korekturaData = await PartnerMinuteService.GetByPartnerAsync(selectedPartner.Sifra, _mesec, _leto);
        }
        catch (Exception ex)
        {
            errorMessage = $"Napaka pri brisanju: {ex.Message}";
        }
    }

    // === Spremembe količin ===
    bool showSpremembePopup;
    bool showSpremembaEdit;
    bool showSpremembaDelete;
    List<ObracunOsnutekSpremembaDto> spremembe = new();
    List<Data.DTOs.ArtikelDto> artikli = new();
    int spremembaEditId;
    string? spremembaArtikel;
    decimal spremembaKolicina;
    string? spremembaOpomba;
    string? spremembaError;
    ObracunOsnutekSpremembaDto? spremembaToDelete;

    async Task OpenSpremembe()
    {
        if (selectedPartner == null) return;
        if (artikli.Count == 0)
            artikli = await ArtikelService.GetAllArtikliAsync();
        ReloadSpremembe();
        showSpremembePopup = true;
    }

    // === Storno iz vsebine računa ===
    OsnutekPosGridDto? focusedPostavka;
    bool showPostavkaMenu;
    double postavkaMenuX;
    double postavkaMenuY;

    void OnPostavkaFocused(GridFocusedRowChangedEventArgs args)
    {
        focusedPostavka = args.DataItem as OsnutekPosGridDto;
    }

    void OnPostavkaContextMenu(MouseEventArgs e)
    {
        if (focusedPostavka == null) return;
        postavkaMenuX = e.ClientX;
        postavkaMenuY = e.ClientY;
        showPostavkaMenu = true;
    }

    async Task StornoFromPostavka()
    {
        showPostavkaMenu = false;
        if (selectedPartner == null || focusedPostavka == null || string.IsNullOrWhiteSpace(focusedPostavka.Artikel))
            return;
        try
        {
            SpremembaService.Insert(_mesec, _leto, selectedPartner.Sifra,
                focusedPostavka.Artikel!, -focusedPostavka.Kolicina, "Storno");
            if (artikli.Count == 0)
                artikli = await ArtikelService.GetAllArtikliAsync();
            ReloadSpremembe();
            showSpremembePopup = true;
        }
        catch (Exception ex)
        {
            errorMessage = $"Napaka: {ex.Message}";
        }
    }

    void ReloadSpremembe()
    {
        if (selectedPartner == null) return;
        spremembe = SpremembaService.GetForPartner(_mesec, _leto, selectedPartner.Sifra);
    }

    void NewSprememba()
    {
        spremembaEditId = 0;
        spremembaArtikel = null;
        spremembaKolicina = 0;
        spremembaOpomba = null;
        spremembaError = null;
        showSpremembaEdit = true;
    }

    void EditSprememba(ObracunOsnutekSpremembaDto item)
    {
        spremembaEditId = item.Id;
        spremembaArtikel = item.Artikel;
        spremembaKolicina = item.Kolicina;
        spremembaOpomba = item.Opomba;
        spremembaError = null;
        showSpremembaEdit = true;
    }

    void SaveSprememba()
    {
        if (selectedPartner == null) return;
        if (string.IsNullOrWhiteSpace(spremembaArtikel))
        {
            spremembaError = "Izberi artikel.";
            return;
        }
        if (spremembaKolicina == 0)
        {
            spremembaError = "Količina ne sme biti 0.";
            return;
        }
        try
        {
            if (spremembaEditId == 0)
                SpremembaService.Insert(_mesec, _leto, selectedPartner.Sifra, spremembaArtikel!, spremembaKolicina, spremembaOpomba);
            else
                SpremembaService.Update(spremembaEditId, spremembaArtikel!, spremembaKolicina, spremembaOpomba);
            showSpremembaEdit = false;
            ReloadSpremembe();
        }
        catch (Exception ex)
        {
            spremembaError = ex.Message;
        }
    }

    void ShowDeleteSprememba(ObracunOsnutekSpremembaDto item)
    {
        spremembaToDelete = item;
        showSpremembaDelete = true;
    }

    void DoDeleteSprememba()
    {
        if (spremembaToDelete != null)
        {
            SpremembaService.Delete(spremembaToDelete.Id);
            spremembaToDelete = null;
            ReloadSpremembe();
        }
        showSpremembaDelete = false;
    }
}
