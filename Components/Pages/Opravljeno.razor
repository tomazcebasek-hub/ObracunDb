}

@code {
    IGrid? gridPartnerji;
    List<OsnutekPartnerDto>? vsiPodatki;
    List<OsnutekPartnerDto>? podatki;
    List<NalogGridDto> nalogi = new();
    List<OsnutekPosGridDto> postavke = new();
    List<PogodbaGridDto> pogodbe = new();
    List<PogodbaPozGridDto> pogodbePozicije = new();
    List<PredracunGridDto> predracuni = new();
    List<PredracunKnjizbaGridDto> predracunPostavke = new();
    List<RocnaPostavkaGridDto> rocnePostavke = new();
    List<RacunGridDto> racuni = new();
    List<RacunGridDto> avansi = new();
    List<RacunKnjizbaDto> selectedRacunPostavke = new();
    OsnutekPartnerDto? selectedPartner;
    NalogGridDto? selectedNalog;
    PogodbaGridDto? selectedPogodba;
    PredracunGridDto? selectedPredracun;
    bool isLoading = true;
    bool showInfoPopup;
    bool showCalcPopup;
    bool pokaziVse;
    string? errorMessage;
    int activeTabIndex;
    int _mesec;
    int _leto;

    int StVseh => vsiPodatki?.Count ?? 0;
    int StPotrjenih => vsiPodatki?.Count(p => !string.IsNullOrEmpty(p.PotrdilKdo)) ?? 0;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _mesec = Parametri.GetInt(ObracunParam.MesecObracuna);
            _leto = Parametri.GetInt(ObracunParam.LetoObracuna);

            vsiPodatki = await ObracunService.GetOsnutkiAsync(_leto, _mesec);
            podatki = vsiPodatki.Where(p => string.IsNullOrEmpty(p.PotrdilKdo)).ToList();
        }
        catch (Exception ex)
        {
            errorMessage = $"Napaka: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    // === CopyNalogi ===
    string copyNalogiText = "CopyNalogi";

    async Task CopyNalogi()
    {
        if (selectedPartner == null) return;

        try
        {
            var obracunaniNalogi = await ObracunService.GetNalogiZaPartnerja(_leto, _mesec, selectedPartner.Sifra, 1);

            if (obracunaniNalogi.Count == 0)
            {
                copyNalogiText = "Ni nalogov!";
                StateHasChanged();
                await Task.Delay(2000);
                copyNalogiText = "CopyNalogi";
                return;
            }

            var sb = new System.Text.StringBuilder();
            sb.Append("<table border='1' cellpadding='4' cellspacing='0' style='border-collapse:collapse; font-family:Calibri,sans-serif; font-size:11pt;'>");
            sb.Append("<tr style='background-color:#4472C4; color:white; font-weight:bold;'>");
            sb.Append("<td colspan='5' style='padding:6px;'>");
            sb.Append($"{selectedPartner.Sifra} – {System.Net.WebUtility.HtmlEncode(selectedPartner.NazivPartnerja ?? "")} &nbsp; ({_mesec}/{_leto})");
            sb.Append("</td></tr>");
            sb.Append("<tr style='background-color:#D6E4F0; font-weight:bold;'>");
            sb.Append("<td>Datum</td><td>Začetek</td><td>Konec</td><td>Serviser</td><td>Opis</td></tr>");

            foreach (var n in obracunaniNalogi)
            {
                sb.Append("<tr>");
                sb.Append($"<td>{n.Datum:dd.MM.yyyy}</td>");
                sb.Append($"<td>{n.ZacetekUra:HH:mm}</td>");
                sb.Append($"<td>{n.KonecUra:HH:mm}</td>");
                sb.Append($"<td>{System.Net.WebUtility.HtmlEncode(n.NazivPotnika ?? "")}</td>");
                sb.Append($"<td style='white-space:pre-wrap;'>{System.Net.WebUtility.HtmlEncode(n.Opis ?? "")}</td>");
                sb.Append("</tr>");
            }

            sb.Append("</table>");

            await JS.InvokeVoidAsync("copyHtmlToClipboard", sb.ToString());

            copyNalogiText = "Kopirano! ✓";
            StateHasChanged();
            await Task.Delay(2000);
            copyNalogiText = "CopyNalogi";
        }
        catch (Exception ex)
        {
            errorMessage = $"Napaka pri kopiranju: {ex.Message}";
        }
    }

    // === Obdobje (mesec/leto dialog) ===
    bool showObdobjePopup;
    int _obdobjeMesec;
    int _obdobjeLeto;

    void OpenObdobje()
    {
        _obdobjeMesec = _mesec;
        _obdobjeLeto = _leto;
        showObdobjePopup = true;
    }

    async Task OnObdobjePotrdi()
    {
        showObdobjePopup = false;
        _mesec = _obdobjeMesec;
        _leto = _obdobjeLeto;

        isLoading = true;
        errorMessage = null;
        selectedPartner = null;
        selectedNalog = null;
        selectedPogodba = null;
        nalogi = new();
        postavke = new();
        pogodbe = new();
        pogodbePozicije = new();
        activeTabIndex = 0;
        pokaziVse = false;

        try
        {
            vsiPodatki = await ObracunService.GetOsnutkiAsync(_leto, _mesec);
            podatki = vsiPodatki.Where(p => string.IsNullOrEmpty(p.PotrdilKdo)).ToList();
        }
        catch (Exception ex)
        {
            errorMessage = $"Napaka: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    async Task PotrdiOsnutek()
    {
        if (selectedPartner == null || !string.IsNullOrEmpty(selectedPartner.PotrdilKdo)) return;

        var partner = selectedPartner;
        partner.PotrdilKdo = ObracunService.TrenutniUporabnik;
        partner.PotrdilKdaj = DateTime.Now;

        try
        {
            await ObracunService.PotrdiOsnutekAsync(_leto, _mesec, partner.Sifra);

            // Skoči na naslednjo vrstico v gridu
            if (podatki != null && gridPartnerji != null)
            {
                var naslednji = podatki
                    .SkipWhile(p => p.Sifra != partner.Sifra)
                    .Skip(1)
                    .FirstOrDefault();

                if (naslednji != null)
                {
                    await gridPartnerji.SetFocusedDataItemAsync(naslednji);
                    await JS.InvokeVoidAsync("scrollFocusedRowIntoView");
                }
            }
        }
        catch (Exception ex)
        {
            partner.PotrdilKdo = null;
            partner.PotrdilKdaj = null;
            errorMessage = $"Napaka pri potrjevanju: {ex.Message}";
        }
    }

    void OnTogglePrikaziVse()
    {
        pokaziVse = !pokaziVse;
        podatki = pokaziVse
            ? vsiPodatki
            : vsiPodatki?.Where(p => string.IsNullOrEmpty(p.PotrdilKdo)).ToList();
    }

    async Task OnPartnerSelected(GridFocusedRowChangedEventArgs e)
    {
        if (e.DataItem is OsnutekPartnerDto row)
        {
            selectedPartner = row;
            selectedNalog = null;
            selectedPogodba = null;
            selectedPredracun = null;
            postavke = await ObracunService.GetPostavkeOsnutkaAsync(_leto, _mesec, row.Sifra);
            await LoadTabData();
        }
    }

    async Task OnTabChanged(int newIndex)
    {
        activeTabIndex = newIndex;
        selectedNalog = null;
        selectedPogodba = null;
        selectedPredracun = null;
        await LoadTabData();
    }

    async Task LoadTabData()
    {
        if (selectedPartner == null) return;

        if (activeTabIndex == 1 || activeTabIndex == 2)
        {
            nalogi = new();
            selectedNalog = null;
            try
            {
                var obracunam = activeTabIndex == 1 ? 1 : 0;
                nalogi = await ObracunService.GetNalogiZaPartnerja(_leto, _mesec, selectedPartner.Sifra, obracunam);
            }
            catch (Exception ex)
            {
                errorMessage = $"Napaka pri nalaganju nalogov: {ex.Message}";
            }
        }
        else if (activeTabIndex == 3)
        {
            pogodbe = new();
            pogodbePozicije = new();
            selectedPogodba = null;
            try
