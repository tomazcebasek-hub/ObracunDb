@page "/paketi"
@using ObracunDb.Data.DTOs
@using ObracunDb.Services
@inject PaketMinuteService PaketService
@inject ArtikelService ArtikelService

<PageTitle>Paketi minut</PageTitle>

<style>
    .action-btn {
        color: #4fc3f7 !important;
        font-size: 16px;
        cursor: pointer;
        padding: 4px 8px;
    }
    .action-btn:hover {
        color: #81d4fa !important;
    }
    .action-btn-danger {
        color: #e57373 !important;
        font-size: 16px;
        cursor: pointer;
        padding: 4px 8px;
    }
    .action-btn-danger:hover {
        color: #ef9a9a !important;
    }
</style>

@if (isLoading)
{
    <p>Nalagam podatke...</p>
}
else
{
    <div style="display:flex; flex-direction:column; flex:1; min-height:0;">
    <div style="flex:1; min-height:0;">
    <DxGrid Data="@paketi"
            KeyFieldName="@nameof(PaketMinuteGridDto.Id)"
            ShowFilterRow="true"
            PageSize="int.MaxValue"
            PagerVisible="false"
            CssClass="w-100 h-100">
        <Columns>
            <DxGridDataColumn FieldName="@nameof(PaketMinuteGridDto.Datum)" Caption="Datum" DisplayFormat="dd.MM.yyyy HH:mm" Width="150px" />
            <DxGridDataColumn FieldName="@nameof(PaketMinuteGridDto.Artikel)" Caption="Šifra" Width="100px" />
            <DxGridDataColumn FieldName="@nameof(PaketMinuteGridDto.NazivArtikla)" Caption="Naziv artikla" />
            <DxGridDataColumn FieldName="@nameof(PaketMinuteGridDto.Enota)" Caption="Enota" Width="100px" />
            <DxGridDataColumn FieldName="@nameof(PaketMinuteGridDto.Minut)" Caption="Minut" Width="100px" />
            <DxGridDataColumn Caption="Akcije" Width="100px">
                <CellDisplayTemplate>
                    @{
                        var item = (PaketMinuteGridDto)context.DataItem;
                    }
                    <span class="action-btn" @onclick="@(() => ShowEditDialog(item))" title="Uredi">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168l10-10zM11.207 2.5 13.5 4.793 14.793 3.5 12.5 1.207 11.207 2.5zm1.586 3L10.5 3.207 4 9.707V10h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.293l6.5-6.5zm-9.761 5.175-.106.106-1.528 3.821 3.821-1.528.106-.106A.5.5 0 0 1 5 12.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.468-.325z"/>
                        </svg>
                    </span>
                    <span class="action-btn-danger" @onclick="@(() => ShowDeleteConfirm(item))" title="Izbriši">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0V6z"/>
                            <path fill-rule="evenodd" d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1v1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4H4.118zM2.5 3V2h11v1h-11z"/>
                        </svg>
                    </span>
                </CellDisplayTemplate>
            </DxGridDataColumn>
        </Columns>
    </DxGrid>
    </div>

    <div class="d-flex gap-2 align-items-center" style="flex-shrink:0; padding:8px 0;">
        <DxButton Text="Nov vnos" 
                  Click="@ShowAddDialog" 
                  RenderStyle="ButtonRenderStyle.Success" />
    </div>
    </div>
}

<DxPopup @bind-Visible="@showDialog"
HeaderText="@dialogTitle"
Width="600px"
ShowFooter="true"
CloseOnEscape="true">
<BodyContentTemplate>
<div class="mb-3" style="display:flex; align-items:center; gap:12px;">
    <label style="min-width:120px; white-space:nowrap;">Artikel</label>
    <DxComboBox Data="@artikli"
                @bind-Value="@selectedArtikelSifra"
                TextFieldName="DisplayName"
                ValueFieldName="Sifra"
                NullText="Izberi artikel..."
                CssClass="w-100"
                FilteringMode="DataGridFilteringMode.Contains" />
</div>
<div class="mb-3" style="display:flex; align-items:center; gap:12px;">
    <label style="min-width:120px; white-space:nowrap;">Število minut</label>
    <DxSpinEdit @bind-Value="@editMinut"
                MinValue="0"
                MaxValue="100000"
                CssClass="w-100" />
</div>
    </BodyContentTemplate>
    <FooterContentTemplate>
        <DxButton Text="Shrani" 
                  Click="@SaveData" 
                  RenderStyle="ButtonRenderStyle.Primary" />
        <DxButton Text="Preklièi" 
                  Click="@(() => showDialog = false)" 
                  RenderStyle="ButtonRenderStyle.Secondary" />
    </FooterContentTemplate>
</DxPopup>

<DxPopup @bind-Visible="@showDeleteDialog"
HeaderText="Potrditev brisanja"
Width="400px"
ShowFooter="true"
CloseOnEscape="true">
    <BodyContentTemplate>
        <p>Ali ste preprièani, da želite izbrisati ta vnos?</p>
    </BodyContentTemplate>
    <FooterContentTemplate>
        <DxButton Text="Izbriši" 
                  Click="@DeleteData" 
                  RenderStyle="ButtonRenderStyle.Danger" />
        <DxButton Text="Preklièi" 
                  Click="@(() => showDeleteDialog = false)" 
                  RenderStyle="ButtonRenderStyle.Secondary" />
    </FooterContentTemplate>
</DxPopup>

@code {
    List<PaketMinuteGridDto>? paketi;
    List<ArtikelDto>? artikli;
    bool isLoading = true;

    // Dialog za dodajanje/urejanje
    bool showDialog = false;
    string dialogTitle = "";
    int? editingId = null;
    string selectedArtikelSifra = "";
    int editMinut = 0;

    // Dialog za brisanje
    bool showDeleteDialog = false;
    int? deleteId = null;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    async Task LoadData()
    {
        isLoading = true;
        try
        {
            paketi = await PaketService.GetAllAsync();
            artikli = await ArtikelService.GetAllArtikliAsync();
        }
        finally
        {
            isLoading = false;
        }
    }

    void ShowAddDialog()
    {
        dialogTitle = "Nov vnos paketa minut";
        editingId = null;
        selectedArtikelSifra = "";
        editMinut = 0;
        showDialog = true;
    }

    void ShowEditDialog(PaketMinuteGridDto item)
    {
        dialogTitle = "Uredi paket minut";
        editingId = item.Id;
        selectedArtikelSifra = item.Artikel;
        editMinut = item.Minut;
        showDialog = true;
    }

    void ShowDeleteConfirm(PaketMinuteGridDto item)
    {
        deleteId = item.Id;
        showDeleteDialog = true;
    }

    async Task SaveData()
    {
        if (string.IsNullOrEmpty(selectedArtikelSifra))
            return;

        try
        {
            if (editingId.HasValue)
            {
                await PaketService.UpdateAsync(editingId.Value, selectedArtikelSifra, editMinut);
            }
            else
            {
                await PaketService.AddAsync(selectedArtikelSifra, editMinut);
            }

            showDialog = false;
            await LoadData();
        }
        catch (Exception ex)
        {
            // TODO: Prikaži napako uporabniku
            Console.WriteLine($"Napaka: {ex.Message}");
        }
    }

    async Task DeleteData()
    {
        if (!deleteId.HasValue)
            return;

        try
        {
            await PaketService.DeleteAsync(deleteId.Value);
            showDeleteDialog = false;
            await LoadData();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Napaka: {ex.Message}");
        }
    }
}
