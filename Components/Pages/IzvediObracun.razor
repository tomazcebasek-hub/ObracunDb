@page "/izvedi-obracun"
@rendermode InteractiveServer
@using ObracunDb.Services
@using ObracunDb.Data.Entities
@inject ParametriService Parametri
@inject ObracunIzvedbaService ObracunIzvedi
@inject FawService FawService
@inject NavigationManager NavigationManager

<PageTitle>Izvedi obračun</PageTitle>

<h5>Pripravi račune</h5>

<DxTabs ActiveTabIndex="@activeTabIndex" ActiveTabIndexChanged="@OnTabChanged">
    <DxTabPage Text="Parametri">
        <div class="p-3" style="max-width:500px;">
            <table class="table table-sm table-borderless">
                <tbody>
                    <tr>
                        <td style="width:120px; vertical-align:middle;"><strong>Mesec</strong></td>
                        <td><DxSpinEdit @bind-Value="@mesec" MinValue="1" MaxValue="12" style="width:120px;" ReadOnly="true" /></td>
                    </tr>
                    <tr>
                        <td style="vertical-align:middle;"><strong>Leto</strong></td>
                        <td><DxSpinEdit @bind-Value="@leto" MinValue="2020" MaxValue="2099" style="width:120px;" ReadOnly="true" /></td>
                    </tr>
                </tbody>
            </table>

            <table class="table table-sm table-borderless mt-2">
                <tbody>
                    @for (int i = 0; i < 5; i++)
                    {
                        var idx = i;
                        <tr>
                            <td style="width:120px; vertical-align:middle;"><strong>Praznik @(idx + 1)</strong></td>
                            <td>
                                <DxDateEdit @bind-Date="@prazniki[idx]"
                                            Format="dd.MM.yyyy"
                                            NullText=""
                                            ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                            style="width:250px;"
                                            Enabled="@(!isRunning)" />
                            </td>
                        </tr>
                    }
                    <tr>
                        <td style="width:120px; vertical-align:middle;"><strong>Debug partner</strong></td>
                        <td>
                            <DxSpinEdit @bind-Value="@debugPartner"
                                        MinValue="0"
                                        MaxValue="9999999"
                                        style="width:250px;"
                                        Enabled="@(!isRunning)" />
                            <small class="text-muted ms-2">0 = brez debug izpisa</small>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </DxTabPage>

    <DxTabPage Text="Dnevnik obračuna">
        <div class="p-3">
            @if (string.IsNullOrEmpty(dnevnik))
            {
                <p class="text-muted">Obračun še ni bil izveden.</p>
            }
            else
            {
                <textarea readonly style="width:100%; height:500px; font-family:monospace; font-size:0.85rem; white-space:pre; overflow:auto;">@dnevnik</textarea>
            }
        </div>
    </DxTabPage>
</DxTabs>

@if (isRunning)
{
    <div class="mt-3" style="max-width:600px;">
        <div class="mb-1"><strong>@statusText</strong></div>
        <div class="progress" style="height:24px;">
            <div class="progress-bar progress-bar-striped progress-bar-animated"
                 role="progressbar"
                 style="width:@(progressPercent)%;"
                 aria-valuenow="@progressPercent" aria-valuemin="0" aria-valuemax="100">
                @(progressPercent)%
            </div>
        </div>
    </div>
}

<div class="d-flex gap-2 mt-3">
    <DxButton Text="Izvedi obračun" RenderStyle="ButtonRenderStyle.Primary" Click="@OnIzvedi" Enabled="@(!isRunning)" />
    <DxButton Text="Zapri" RenderStyle="ButtonRenderStyle.Secondary" Click="@OnZapri" Enabled="@(!isRunning)" />
</div>

@if (rezultatSporocilo != null)
{
    <div class="alert @(rezultatUspeh ? "alert-success" : "alert-danger") mt-3" style="max-width:600px;">@rezultatSporocilo</div>
}

@code {
    int activeTabIndex;
    int mesec;
    int leto;
    DateTime?[] prazniki = new DateTime?[5];
    int debugPartner;
    string dnevnik = "";

    bool isRunning;
    string statusText = "";
    int progressPercent;
    string? rezultatSporocilo;
    bool rezultatUspeh;

    protected override async Task OnInitializedAsync()
    {
        mesec = Parametri.GetInt(ObracunParam.MesecObracuna);
        leto = Parametri.GetInt(ObracunParam.LetoObracuna);

        for (int i = 0; i < 5; i++)
        {
            var val = Parametri.GetString(ParametriService.Praznik(i + 1));
            if (!string.IsNullOrWhiteSpace(val) && DateTime.TryParse(val, out var dt))
                prazniki[i] = dt;
        }

        debugPartner = Parametri.GetInt(ObracunParam.DebugPartner);

        await NaloziDnevnikAsync();
    }

    async Task NaloziDnevnikAsync()
    {
        try
        {
            dnevnik = await ObracunIzvedi.GetObracunLogAsync(leto, mesec) ?? "";
        }
        catch
        {
            dnevnik = "";
        }
    }

    async Task OnTabChanged(int newIndex)
    {
        activeTabIndex = newIndex;
        if (newIndex == 1 && !isRunning)
            await NaloziDnevnikAsync();
    }

    async Task OnIzvedi()
    {
        isRunning = true;
        rezultatSporocilo = null;
        dnevnik = "";
        activeTabIndex = 1;

        // Preveri, ali so že preneseni računi v FAW
        try
        {
            var fawStanje = FawService.PridobiStanje(mesec, leto);
            if (fawStanje.ZePrenesenih > 0)
            {
                rezultatSporocilo = $"Obračun ni možen: {fawStanje.ZePrenesenih} računov je že prenesenih v FAW. Najprej izbrišite račune v FAW ali ponastavite prenos.";
                rezultatUspeh = false;
                isRunning = false;
                return;
            }
        }
        catch (Exception ex)
        {
            rezultatSporocilo = $"Napaka pri preverjanju FAW stanja: {ex.Message}";
            rezultatUspeh = false;
            isRunning = false;
            return;
        }

        // Shrani praznike v bazo
        for (int i = 0; i < 5; i++)
        {
            var val = prazniki[i]?.ToString("yyyy-MM-dd") ?? "";
            await Parametri.SaveToDatabaseAsync(ParametriService.Praznik(i + 1), val);
        }

        // Shrani debug partnerja v bazo
        await Parametri.SaveToDatabaseAsync(ObracunParam.DebugPartner, debugPartner.ToString());

        var praznikiSet = new HashSet<DateTime>();
        foreach (var p in prazniki)
        {
            if (p.HasValue)
                praznikiSet.Add(p.Value.Date);
        }

        try
        {
            await SetProgress(10, "Izvajam obračun...");

            var rezultat = await Task.Run(() => ObracunIzvedi.IzvediObracun(mesec, leto, praznikiSet, debugPartner));

            await SetProgress(100, "Končano.");

            dnevnik = string.Join(Environment.NewLine, rezultat.Log);
            rezultatUspeh = rezultat.Success;
            rezultatSporocilo = rezultat.Message;
        }
        catch (Exception ex)
        {
            rezultatUspeh = false;
            rezultatSporocilo = $"Napaka: {ex.Message}";
            dnevnik += $"\nNAPAKA: {ex.Message}";
        }
        finally
        {
            isRunning = false;
        }
    }

    async Task SetProgress(int percent, string text)
    {
        progressPercent = percent;
        statusText = text;
        StateHasChanged();
        await Task.Delay(100);
    }

    void OnZapri()
    {
        NavigationManager.NavigateTo("/");
    }
}
