@page "/partnerji-primerjava"
@rendermode InteractiveServer
@using ObracunDb.Data.DTOs
@using ObracunDb.Data.Entities
@using ObracunDb.Services
@inject PartnerPrimerjavaService PrimerjavaService
@inject ParametriService Parametri
@inject NavigationManager NavigationManager

<PageTitle>Primerjava med leti</PageTitle>

<div style="display: flex; flex-direction: column; height: calc(100vh - 4rem); gap: 8px;">
    <div style="display:flex; align-items:center; gap:8px; flex-shrink:0;">
        <h5 style="margin:0;">Primerjava med leti</h5>
        <DxButton Text="Nazaj" RenderStyle="ButtonRenderStyle.Secondary" Click="@(() => NavigationManager.NavigateTo("/partnerji"))" />
        <button type="button" title="Izvoz v Excel (XLSX)" @onclick="IzvoziVExcel" disabled="@(grid == null)"
                style="display:inline-flex; align-items:center; justify-content:center; padding:4px; border:none; background:transparent; cursor:pointer; margin-left:auto;">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                <rect x="3" y="3" width="14" height="14" rx="1.5" stroke="#1D6F42" stroke-width="1.3" />
                <path d="M3 7H17" stroke="#1D6F42" stroke-width="1.3" />
                <path d="M7 3V17" stroke="#1D6F42" stroke-width="1.3" />
                <path d="M9.5 9.5L14 14.5M14 9.5L9.5 14.5" stroke="#1D6F42" stroke-width="1.3" stroke-linecap="round" />
            </svg>
        </button>
    </div>

    @if (isLoading)
    {
        <p>Nalagam podatke...</p>
    }
    else if (errorMessage != null)
    {
        <div class="alert alert-danger">@errorMessage</div>
    }
    else
    {
        <div style="flex: 1; overflow: auto;">
            <DxGrid @ref="grid"
                    Data="@vrstice"
                    KeyFieldName="@nameof(PartnerPrimerjavaDto.Sifra)"
                    PageSize="int.MaxValue"
                    PagerVisible="false"
                    ShowFilterRow="true"
                    FilterMenuButtonDisplayMode="GridFilterMenuButtonDisplayMode.Always"
                    AllowSort="true"
                    CssClass="w-100 h-100">
                <Columns>
                    <DxGridDataColumn FieldName="@nameof(PartnerPrimerjavaDto.Sifra)" Caption="Šifra" Width="120px" />
                    <DxGridDataColumn FieldName="@nameof(PartnerPrimerjavaDto.Naziv)" Caption="Naziv partnerja" />
                    <DxGridDataColumn FieldName="@nameof(PartnerPrimerjavaDto.Znesek1)" Caption="@($"Znesek {leto1}")" DisplayFormat="N2" Width="180px" />
                    <DxGridDataColumn FieldName="@nameof(PartnerPrimerjavaDto.Znesek2)" Caption="@($"Znesek {leto2}")" DisplayFormat="N2" Width="180px" />
                    <DxGridDataColumn FieldName="@nameof(PartnerPrimerjavaDto.Razlika)" Caption="Razlika" DisplayFormat="N2" Width="160px" />
                    <DxGridDataColumn FieldName="@nameof(PartnerPrimerjavaDto.Procent)" Caption="%" DisplayFormat="N2" Width="110px" />
                    <DxGridDataColumn FieldName="@nameof(PartnerPrimerjavaDto.Znesek1DoDanes)" Caption="@($"{leto1} do danes")" DisplayFormat="N2" Width="180px" />
                    <DxGridDataColumn FieldName="@nameof(PartnerPrimerjavaDto.RazlikaDoDanes)" Caption="Razlika do danes" DisplayFormat="N2" Width="170px" />
                    <DxGridDataColumn FieldName="@nameof(PartnerPrimerjavaDto.ProcentDoDanes)" Caption="% do danes" DisplayFormat="N2" Width="130px" />
                </Columns>
                <TotalSummary>
                    <DxGridSummaryItem SummaryType="GridSummaryItemType.Count" FieldName="@nameof(PartnerPrimerjavaDto.Sifra)" DisplayText="Partnerjev: {0}" />
                    <DxGridSummaryItem SummaryType="GridSummaryItemType.Sum" FieldName="@nameof(PartnerPrimerjavaDto.Znesek1)" DisplayText="{0:N2}" />
                    <DxGridSummaryItem SummaryType="GridSummaryItemType.Sum" FieldName="@nameof(PartnerPrimerjavaDto.Znesek2)" DisplayText="{0:N2}" />
                    <DxGridSummaryItem SummaryType="GridSummaryItemType.Sum" FieldName="@nameof(PartnerPrimerjavaDto.Razlika)" DisplayText="{0:N2}" />
                    <DxGridSummaryItem SummaryType="GridSummaryItemType.Sum" FieldName="@nameof(PartnerPrimerjavaDto.Znesek1DoDanes)" DisplayText="{0:N2}" />
                    <DxGridSummaryItem SummaryType="GridSummaryItemType.Sum" FieldName="@nameof(PartnerPrimerjavaDto.RazlikaDoDanes)" DisplayText="{0:N2}" />
                </TotalSummary>
            </DxGrid>
        </div>
    }
</div>

@code {
    List<PartnerPrimerjavaDto>? vrstice;
    IGrid? grid;
    bool isLoading = true;
    string? errorMessage;
    int leto2;  // tekoče leto obračuna
    int leto1;  // prejšnje leto

    protected override async Task OnInitializedAsync()
    {
        leto2 = Parametri.GetInt(ObracunParam.LetoObracuna);
        leto1 = leto2 - 1;

        try
        {
            vrstice = await PrimerjavaService.GetPrimerjavaAsync(leto1, leto2);
        }
        catch (Exception ex)
        {
            errorMessage = $"Napaka: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    async Task IzvoziVExcel()
    {
        if (grid == null) return;

        await grid.ExportToXlsxAsync($"Partnerji_primerjava_{leto1}_{leto2}");
    }
}
