@page "/nastavitve"
@using ObracunDb.Services
@using ObracunDb.Data.Entities
@using ObracunDb.Data.DTOs
@using System.Net.Http
@inject ParametriService Parametri
@inject ArtikelService ArtikelService
@inject AuthService AuthService
@inject FawService FawService
@inject NavigationManager NavigationManager

<PageTitle>Nastavitve</PageTitle>

@if (isLoading)
{
    <p>Nalagam podatke...</p>
}
else
{
    <DxTabs @bind-ActiveTabIndex="@activeTabIndex">
        <DxTabPage Text="Splošno">
            <div class="p-3" style="max-width:1750px;">
                <table class="table table-sm table-borderless">
                    <tbody>
                        <tr>
                            <td style="width:250px; vertical-align:middle;"><strong>Šifra artikla za kilometrino</strong></td>
                            <td>
                                <DxComboBox Data="@artikli"
                                            Value="@sifraKilometrina"
                                            ValueChanged="@((string v) => OnKilometrinaSifraChanged(v))"
                                            TextFieldName="DisplayName"
                                            ValueFieldName="Sifra"
                                            NullText="Izberi artikel..."
                                            CssClass="w-100"
                                            FilteringMode="DataGridFilteringMode.Contains"
                                            ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                            </td>
                        </tr>
                        <tr>
                            <td style="vertical-align:middle;"><strong>Procent popusta pogodbe</strong></td>
                            <td><DxSpinEdit @bind-Value="@procentPopusta" MinValue="0" MaxValue="100" CssClass="w-100" /></td>
                        </tr>
                        <tr>
                            <td style="vertical-align:middle;"><strong>Toleranca minut za obračun</strong></td>
                            <td><DxSpinEdit @bind-Value="@tolerancaMinut" MinValue="0" MaxValue="999" CssClass="w-100" /></td>
                        </tr>
                    </tbody>
                </table>

                @if (isAdminOrVodja)
                {
                    <h6 class="mt-4 mb-3"><strong>VASCO API nastavitve</strong></h6>
                    <table class="table table-sm table-borderless">
                        <tbody>
                            <tr>
                                <td style="width:250px; vertical-align:middle;"><strong>API URL</strong></td>
                                <td><DxTextBox @bind-Text="@vascoApiUrl" CssClass="w-100" /></td>
                            </tr>
                            <tr>
                                <td style="vertical-align:middle;"><strong>Uporabniško ime</strong></td>
                                <td><DxTextBox @bind-Text="@vascoApiUporabnik" CssClass="w-100" /></td>
                            </tr>
                            <tr>
                                <td style="vertical-align:middle;"><strong>Geslo</strong></td>
                                <td><DxTextBox @bind-Text="@vascoApiGeslo" Password="true" CssClass="w-100" /></td>
                            </tr>
                            <tr>
                                <td style="vertical-align:middle;"><strong>Davčna številka</strong></td>
                                <td><DxTextBox @bind-Text="@vascoApiDavcna" CssClass="w-100" /></td>
                            </tr>
                        </tbody>
                    </table>
                    <div class="d-flex gap-2 mt-2">
                        <DxButton Text="@testButtonText" RenderStyle="ButtonRenderStyle.Info" Click="@OnTestVascoApi" Enabled="@(!isTesting)" />
                        <DxButton Text="Faktura" RenderStyle="ButtonRenderStyle.Info" Click="@OnFakturaVascoApi" />
                        <DxButton Text="Počisti log" RenderStyle="ButtonRenderStyle.Secondary" Click="@(() => vascoLog = "")" />
                        <DxButton Text="dagama" RenderStyle="ButtonRenderStyle.Secondary" Click="@OnNapolniDagama" />
                    </div>
                    @if (!string.IsNullOrEmpty(vascoLog))
                    {
                        <h6 class="mt-3 mb-2"><strong>Status / Log:</strong></h6>
                        <textarea readonly style="width:100%; height:400px; font-family:monospace; font-size:0.85rem; white-space:pre; overflow:auto;">@vascoLog</textarea>
                    }
                }

                @if (lahkoPonastavi)
                {
                    <h6 class="mt-4 mb-3"><strong>Ponastavi prenos v FAW</strong></h6>
                    <table class="table table-sm table-borderless">
                        <tbody>
                            <tr>
                                <td style="width:250px; vertical-align:middle;"><strong>Mesec</strong></td>
                                <td><DxSpinEdit @bind-Value="@ponastaviMesec" MinValue="1" MaxValue="12" style="width:120px;" /></td>
                            </tr>
                            <tr>
                                <td style="vertical-align:middle;"><strong>Leto</strong></td>
                                <td><DxSpinEdit @bind-Value="@ponastaviLeto" MinValue="2000" MaxValue="2100" style="width:120px;" /></td>
                            </tr>
                        </tbody>
                    </table>
                    <div class="d-flex gap-2 mt-2">
                        <DxButton Text="Ponastavi prenos" RenderStyle="ButtonRenderStyle.Warning" Click="@(() => showPonastaviConfirm = true)" Enabled="@(!showPonastaviConfirm)" />
                    </div>
                    @if (showPonastaviConfirm)
                    {
                        <div class="alert alert-warning mt-3">
                            <p>Ponastaviti prenos v FAW za <strong>@ponastaviMesec/@ponastaviLeto</strong>? To počisti številke računov na osnutkih in ločenih računih za to obdobje.</p>
                            <div class="d-flex gap-2 mt-2">
                                <DxButton Text="Da, ponastavi" RenderStyle="ButtonRenderStyle.Danger" Click="@OnPonastaviPrenos" />
                                <DxButton Text="Prekliči" RenderStyle="ButtonRenderStyle.Secondary" Click="@(() => showPonastaviConfirm = false)" />
                            </div>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(ponastaviSporocilo))
                    {
                        <div class="alert @(ponastaviUspeh ? "alert-success" : "alert-danger") mt-2">@ponastaviSporocilo</div>
                    }
                }
            </div>
        </DxTabPage>

        <DxTabPage Text="HD Servisna">
            <div class="p-3">
                <table class="table table-sm table-bordered">
                    <thead>
                        <tr>
                            <th style="width:280px;">Obdobje</th>
                            <th style="min-width:500px;">Artikel</th>
                            <th style="width:100px;">Enota</th>
                            <th style="width:120px;">Prodajna cena</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var (_, suffix) in VrsticeConfig)
                        {
                            var key = "Servisna" + suffix;
                            if (artikelVrstice.TryGetValue(key, out var vrstica))
                            {
                                var localKey = key;
                                <tr>
                                    <td style="vertical-align:middle;">@vrstica.Naziv</td>
                                    <td>
                                        <DxComboBox Data="@artikli"
                                                    Value="@vrstica.Sifra"
                                                    ValueChanged="@((string v) => OnSifraChanged(localKey, v))"
