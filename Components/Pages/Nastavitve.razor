                                                </table>
                                            </div>
                                        </DxTabPage>

                                        <DxTabPage Text="Delavnica servisna">
                                            <div class="p-3">
                                                <table class="table table-sm table-bordered">
                                                    <thead>
                                                        <tr>
                                                            <th style="width:280px;">Obdobje</th>
                                                            <th style="min-width:500px;">Artikel</th>
                                                            <th style="width:100px;">Enota</th>
